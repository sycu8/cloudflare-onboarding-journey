{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onboarding.orangecloud.vn/schemas/blog-review-report.json",
  "title": "Blog review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rubricVersion",
    "slug",
    "date",
    "round",
    "reviewedAt",
    "reviewer",
    "verdict",
    "overallScore",
    "categories",
    "claims",
    "findings",
    "sourcesChecked"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rubricVersion": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "reviewedAt": {
      "type": "string",
      "minLength": 10
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "model",
        "network"
      ],
      "properties": {
        "deterministic": {
          "const": true
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "network": {
          "type": "boolean"
        }
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "overallScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factual",
        "structure",
        "bilingual",
        "seo",
        "code",
        "images",
        "diagrams"
      ],
      "properties": {
        "factual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "threshold",
            "pass"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "pass": {
              "type": "boolean"
            }
          }
        },
        "structure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "threshold",
            "pass"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "pass": {
              "type": "boolean"
            }
          }
        },
        "bilingual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "threshold",
            "pass"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "pass": {
              "type": "boolean"
            }
          }
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "threshold",
            "pass"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "pass": {
              "type": "boolean"
            }
          }
        },
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "threshold",
            "pass"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "pass": {
              "type": "boolean"
            }
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "threshold",
            "pass"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "pass": {
              "type": "boolean"
            }
          }
        },
        "diagrams": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "threshold",
            "pass"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "pass": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "location",
          "sourceUrl",
          "quote",
          "quoteFound",
          "verdict"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C\\d{1,3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "pattern": "^(title|description|excerpt|s\\d+\\.p\\d+|s\\d+\\.heading|faq\\d+\\.(q|a)|image\\d+)$"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "quoteFound": {
            "type": "boolean"
          },
          "verdict": {
            "enum": [
              "supported",
              "contradicted",
              "unverifiable",
              "outdated"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "category",
          "severity",
          "message"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-\\d{3}$"
          },
          "category": {
            "enum": [
              "factual",
              "structure",
              "bilingual",
              "seo",
              "code",
              "images",
              "diagrams"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "sourcesChecked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "official",
          "status"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "official": {
            "type": "boolean"
          },
          "status": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
