---
import type { LabBlock } from '../../data/developerLabArticles';
import { tLab } from '../../data/developerLabs.vi';
import { tLabKm } from '../../data/developerLabs.km';
import { labCalloutKindLabel, labChrome } from '../../data/developerLabs.copy';

type Props = { blocks: LabBlock[] };
const { blocks } = Astro.props;

function isSectionHeading(level: number) {
  return level <= 2;
}

const calloutClass: Record<string, string> = {
  tip: 'lab-callout lab-callout-tip',
  note: 'lab-callout lab-callout-note',
  important: 'lab-callout lab-callout-important',
  caution: 'lab-callout lab-callout-caution',
  warning: 'lab-callout lab-callout-caution',
  danger: 'lab-callout lab-callout-caution',
  tool: 'lab-callout lab-callout-tool',
  globe: 'lab-callout lab-callout-tool',
};

function youtubeId(src: string): string {
  const m = src.match(/embed\/([^?&]+)/);
  return m?.[1] ?? 'video';
}

/** Wrap plain callout bodies in <strong> so notes stay bold even without source markup. */
function emphasizeCalloutHtml(html: string): string {
  const trimmed = (html || '').trim();
  if (!trimmed) return '';
  const mixed = trimmed.match(/^([^]*?)(<(?:ul|ol|pre|table)\b)/i);
  if (mixed && mixed[1].trim()) {
    return `<p class="lab-callout-emph"><strong>${mixed[1].trim()}</strong></p>${trimmed.slice(mixed[1].length)}`;
  }
  if (/^<(ul|ol|p|div|pre|table|blockquote)/i.test(trimmed)) {
    return `<div class="lab-callout-emph">${trimmed}</div>`;
  }
  return `<p class="lab-callout-emph"><strong>${trimmed}</strong></p>`;
}
---

<div class="lab-article space-y-5">
  {
    blocks.map((block) => {
      if (block.type === 'heading') {
        if (isSectionHeading(block.level)) {
          return (
            <h2 class="scroll-mt-24 text-lg font-semibold md:text-xl">
              <span class="lang-vi">{tLab(block.text)}</span>
              <span class="lang-en">{block.text}</span>
              <span class="lang-km">{tLabKm(block.text)}</span>
            </h2>
          );
        }
        return (
            <h3 class="scroll-mt-24 text-base font-semibold">
              <span class="lang-vi">{tLab(block.text)}</span>
              <span class="lang-en">{block.text}</span>
              <span class="lang-km">{tLabKm(block.text)}</span>
            </h3>
        );
      }
      if (block.type === 'p') {
        return (
          <div>
            <p class="lang-vi text-sm leading-relaxed" set:html={block.html} />
            <p class="lang-en text-sm leading-relaxed" set:html={block.html} />
            <p class="lang-km text-sm leading-relaxed" set:html={block.html} />
          </div>
        );
      }
      if (block.type === 'list') {
        if (block.ordered) {
          return (
            <ol class="list-decimal space-y-1 pl-5 text-sm leading-relaxed">
              {block.items.map((item) => (
                <li set:html={item} />
              ))}
            </ol>
          );
        }
        return (
          <ul class="list-disc space-y-1 pl-5 text-sm leading-relaxed">
            {block.items.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        );
      }
      if (block.type === 'code') {
        return (
          <div class="overflow-x-auto rounded-xl border border-[var(--cf-border)] bg-[#111111]">
            {block.lang ? (
              <div class="border-b border-white/10 px-3 py-1 font-mono text-[10px] uppercase tracking-wide text-[var(--cf-accent)]">
                {block.lang}
              </div>
            ) : null}
            <pre class="lab-code p-3 text-xs leading-relaxed text-white"><code>{block.code}</code></pre>
          </div>
        );
      }
      if (block.type === 'context') {
        return (
          <dl class="lab-context grid gap-3 sm:grid-cols-2">
            {block.items.map((item) => (
              <div class="rounded-xl border border-[var(--cf-border)] bg-[var(--cf-bg-elevated)] p-3">
                {item.label ? (
                  <dt class="text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-[var(--cf-accent)]">
                    <span class="lang-vi">{tLab(item.label)}</span>
                    <span class="lang-en">{item.label}</span>
                    <span class="lang-km">{tLabKm(item.label)}</span>
                  </dt>
                ) : null}
                <dd class="mt-1 text-sm leading-relaxed" set:html={item.html} />
              </div>
            ))}
          </dl>
        );
      }
      if (block.type === 'callout') {
        const cls = calloutClass[block.kind] ?? calloutClass.note;
        const kindLabel = labCalloutKindLabel[block.kind] ?? labCalloutKindLabel.note;
        return (
          <aside class={cls} role="note">
            <div class="lab-callout-head">
              <span class="lab-callout-kind">
                <span class="lang-vi">{kindLabel.vi}</span>
                <span class="lang-en">{kindLabel.en}</span>
                <span class="lang-km">{kindLabel.km}</span>
              </span>
              {block.title ? (
                <p class="lab-callout-title">
                  <span class="lang-vi">{tLab(block.title)}</span>
                  <span class="lang-en">{block.title}</span>
                  <span class="lang-km">{tLabKm(block.title)}</span>
                </p>
              ) : null}
            </div>
            <div class="lab-callout-body" set:html={emphasizeCalloutHtml(block.html)} />
          </aside>
        );
      }
      if (block.type === 'challenge') {
        return (
          <aside class="lab-challenge" role="note">
            <p class="lab-callout-kind lab-callout-kind-challenge">
              <span class="lang-vi">{labChrome.challenge.vi}</span>
              <span class="lang-en">{labChrome.challenge.en}</span>
              <span class="lang-km">{labChrome.challenge.km}</span>
            </p>
            <p class="lab-callout-title mt-2">
              <span class="lang-vi">{tLab(block.title)}</span>
              <span class="lang-en">{block.title}</span>
              <span class="lang-km">{tLabKm(block.title)}</span>
            </p>
            <div class="lab-challenge-body mt-2" set:html={emphasizeCalloutHtml(block.html)} />
          </aside>
        );
      }
      if (block.type === 'youtube') {
        return (
          <figure class="lab-video overflow-hidden rounded-xl border border-[var(--cf-border)] bg-[#111111]">
            <div class="relative aspect-video">
              <iframe
                src={block.src}
                title={block.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                class="absolute inset-0 h-full w-full"
                id={`yt-${youtubeId(block.src)}`}
              />
            </div>
            <figcaption class="px-3 py-2 text-xs text-white/70">{block.title}</figcaption>
          </figure>
        );
      }
      return null;
    })
  }
</div>

<style>
  .lab-code {
    margin: 0;
    white-space: pre;
    tab-size: 2;
  }

  .lab-callout {
    border-radius: 0.95rem;
    border: 1px solid var(--cf-border);
    border-left-width: 5px;
    border-left-color: var(--cf-accent);
    background: color-mix(in srgb, var(--cf-accent) 12%, var(--cf-bg));
    padding: 0.95rem 1.05rem;
    box-shadow: 0 10px 24px -18px rgba(0, 0, 0, 0.45);
  }

  .lab-callout-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.7rem;
  }

  .lab-callout-kind {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    padding: 0.18rem 0.55rem;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lab-callout-note .lab-callout-kind::before,
  .lab-callout-tip .lab-callout-kind::before {
    content: '!';
    font-weight: 800;
  }

  .lab-callout-important .lab-callout-kind::before,
  .lab-callout-caution .lab-callout-kind::before {
    content: '⚠';
    letter-spacing: 0;
  }

  .lab-callout-kind-challenge {
    background: var(--cf-accent);
    color: #111111;
  }

  .lab-callout-title {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 800;
    line-height: 1.35;
    color: var(--cf-text);
  }

  .lab-callout-note {
    border-left-color: var(--cf-accent);
    background: color-mix(in srgb, var(--cf-accent) 14%, var(--cf-bg));
  }

  .lab-callout-tip,
  .lab-callout-important {
    border-left-color: var(--cf-accent);
    background: color-mix(in srgb, var(--cf-accent) 16%, var(--cf-bg));
  }

  .lab-callout-important .lab-callout-kind {
    background: var(--cf-accent);
    color: #111111;
  }

  .lab-callout-caution {
    border-left-color: #dc2626;
    background: color-mix(in srgb, #f59e0b 18%, var(--cf-bg));
  }

  .lab-callout-caution .lab-callout-kind {
    background: #dc2626;
    color: #ffffff;
  }

  .lab-callout-tool {
    border-left-color: var(--cf-accent);
    border-color: #111111;
    background: #111111;
    color: #ffffff;
  }

  .lab-callout-tool .lab-callout-title {
    color: #ffffff;
  }

  .lab-callout-tool .lab-callout-kind {
    background: var(--cf-accent);
    color: #111111;
  }

  .lab-callout-body,
  .lab-challenge-body {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.55;
    color: var(--cf-text);
  }

  .lab-callout-emph,
  .lab-callout-emph strong,
  .lab-callout-body :global(strong),
  .lab-challenge-body :global(strong) {
    font-weight: 800;
  }

  .lab-callout-tool .lab-callout-body {
    color: rgba(255, 255, 255, 0.92);
  }

  .lab-callout-body :global(ul),
  .lab-callout-body :global(ol),
  .lab-challenge-body :global(ul),
  .lab-challenge-body :global(ol) {
    margin: 0.4rem 0 0;
    padding-left: 1.15rem;
  }

  .lab-callout-body :global(ul),
  .lab-challenge-body :global(ul) {
    list-style: disc;
  }

  .lab-callout-body :global(ol),
  .lab-challenge-body :global(ol) {
    list-style: decimal;
  }

  .lab-callout-body :global(p + p),
  .lab-challenge-body :global(p + p) {
    margin-top: 0.5rem;
  }

  .lab-callout-body :global(code),
  .lab-challenge-body :global(code),
  .lab-article :global(p code),
  .lab-article :global(li code),
  .lab-context :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8em;
    border-radius: 0.3rem;
    background: var(--cf-bg-elevated);
    padding: 0.05rem 0.3rem;
  }

  .lab-callout-tool :global(code) {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .lab-challenge {
    border-radius: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--cf-accent) 50%, var(--cf-border));
    border-left-width: 5px;
    border-left-color: var(--cf-accent);
    background: color-mix(in srgb, var(--cf-accent) 12%, var(--cf-bg));
    padding: 1rem 1.05rem;
    box-shadow: 0 10px 24px -18px rgba(0, 0, 0, 0.45);
  }

  html.dark .lab-callout-tool {
    background: #000000;
  }

  html.dark .lab-callout-note,
  html.dark .lab-callout-tip,
  html.dark .lab-callout-important {
    background: color-mix(in srgb, var(--cf-accent) 18%, #0a0a0a);
  }

  html.dark .lab-callout-caution {
    background: color-mix(in srgb, #f59e0b 16%, #0a0a0a);
  }
</style>
