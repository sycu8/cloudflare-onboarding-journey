---
import LangText from '../ui/LangText.astro';
import {
  blogLevelLabels,
  blogPostPath,
  blogTopicLabels,
  type BlogPost,
} from '../../data/blog';
import { getDiagramBySlug } from '../../data/referenceDiagrams';

type Props = { post: BlogPost };
const { post } = Astro.props;
const href = blogPostPath(post.slug);
const thumb =
  post.images?.[0]?.src ??
  (post.diagramSlugs?.[0] ? getDiagramBySlug(post.diagramSlugs[0])?.primaryImageUrl : undefined);
const thumbAlt = post.images?.[0]?.alt.en ?? post.title.en;
---

<article class="card flex h-full flex-col overflow-hidden p-0">
  {
    thumb ? (
      <a href={href} class="block border-b border-[var(--cf-border)] bg-[var(--cf-bg-elevated)]">
        <img
          src={thumb}
          alt={thumbAlt}
          loading="lazy"
          decoding="async"
          class="h-36 w-full object-contain object-center p-3 md:h-40"
        />
      </a>
    ) : null
  }
  <div class="flex flex-1 flex-col p-5">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
      <span class="badge">
        <LangText text={blogTopicLabels[post.topic]} />
      </span>
      <span class="badge">
        <LangText text={blogLevelLabels[post.level]} />
      </span>
      <time class="text-muted" datetime={post.date}>{post.date}</time>
      <span class="text-muted">
        <span class="lang-vi">~{post.readingMinutes} phút</span>
        <span class="lang-en">~{post.readingMinutes} min</span>
        <span class="lang-km">~{post.readingMinutes} នាទី</span>
      </span>
    </div>
    <h2 class="text-lg font-semibold leading-snug">
      <a class="link" href={href}>
        <LangText text={post.title} />
      </a>
    </h2>
    <LangText as="p" class="text-muted mt-2 flex-1 text-sm leading-relaxed" text={post.excerpt} />
    <p class="mt-4">
      <a class="btn btn-secondary" href={href}>
        <LangText text={{ vi: 'Đọc bài →', en: 'Read post →', km: 'អានអត្ថបទ →' }} />
      </a>
    </p>
  </div>
</article>
