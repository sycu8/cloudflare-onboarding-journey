---
import LangText from '../ui/LangText.astro';

const src = '/images/cloudflare-connectivity-cloud.png';
---

<figure class="card mt-6 overflow-hidden p-0">
  <div class="border-b border-[var(--cf-border)] bg-[var(--cf-surface)] px-4 py-3 sm:px-5">
    <LangText
      as="figcaption"
      class="text-sm font-semibold"
      text={{
        vi: 'Đám mây kết nối Cloudflare — Kết nối · Bảo vệ · Xây dựng',
        en: "Cloudflare's connectivity cloud — Connect · Protect · Build",
        km: 'ពពំោយ Cloudflare connectivity cloud — តភ្ជាប់ · ពារ · សាង',
      }}
    />
    <LangText
      as="p"
      class="text-muted mt-1 text-xs leading-relaxed"
      text={{
        vi: 'Sơ đồ chính thức: một nền tảng thống nhất (70+ dịch vụ) trên mạng lưới edge toàn cầu. Ba cột tương ứng ba lộ trình học trên hub — Application Services (Kết nối + Bảo vệ ứng dụng), Developer Platform (Xây dựng), Cloudflare One (Bảo vệ người dùng / SASE).',
        en: 'Official view: one unified platform (70+ services) on a global edge network. Three columns map to hub tracks — Application Services (Connect + Protect apps), Developer Platform (Build), Cloudflare One (Protect users / SASE).',
        km: 'ទិដ្ឋភាពផ្លូវការ៖ វេទិការួមតែមួយ (សេវាកម្ម ៧០+) លើបណ្តាញ edge ទូទាំងពិភពលោក។ បីជួរស្របនឹងផ្លូវសិក្សាលើ hub — Application Services (តភ្ជាប់ + ពារកម្មវិធី), Developer Platform (សាង), Cloudflare One (ពារអ្នកប្រើ / SASE)។',
      }}
    />
  </div>
  <div class="bg-white p-3 dark:bg-zinc-950 sm:p-4">
    <img
      src={src}
      width={1200}
      height={675}
      loading="lazy"
      decoding="async"
      class="mx-auto h-auto w-full max-w-4xl rounded-md"
      alt="Cloudflare connectivity cloud diagram with three columns Connect, Protect, and Build, on a foundation of unified platform and global network"
    />
  </div>
  <div class="grid gap-2 border-t border-[var(--cf-border)] px-4 py-3 text-xs sm:grid-cols-3 sm:px-5">
    <p>
      <span class="lang-vi"><span class="font-semibold text-[var(--cf-accent)]">Kết nối</span> — CDN, DNS, SASE, routing</span>
      <span class="lang-en"><span class="font-semibold text-[var(--cf-accent)]">Connect</span> — CDN, DNS, SASE, routing</span>
      <span class="lang-km"><span class="font-semibold text-[var(--cf-accent)]">តភ្ជាប់</span> — CDN, DNS, SASE, routing</span>
    </p>
    <p>
      <span class="lang-vi"><span class="font-semibold text-[var(--cf-accent)]">Bảo vệ</span> — WAF, API, bot, Zero Trust</span>
      <span class="lang-en"><span class="font-semibold text-[var(--cf-accent)]">Protect</span> — WAF, API, bot, Zero Trust</span>
      <span class="lang-km"><span class="font-semibold text-[var(--cf-accent)]">ពារ</span> — WAF, API, bot, Zero Trust</span>
    </p>
    <p>
      <span class="lang-vi"><span class="font-semibold text-[var(--cf-accent)]">Xây dựng</span> — Workers, AI, storage, media</span>
      <span class="lang-en"><span class="font-semibold text-[var(--cf-accent)]">Build</span> — Workers, AI, storage, media</span>
      <span class="lang-km"><span class="font-semibold text-[var(--cf-accent)]">សាង</span> — Workers, AI, storage, media</span>
    </p>
  </div>
</figure>
