---
import LangText from '../ui/LangText.astro';
import { tutorialChrome } from '../../data/tutorialCopy';
import {
  getTutorialSectionSummaryEn,
  getTutorialSectionSummaryKm,
  type TutorialSection,
} from '../../data/tutorialPreviews';

type Props = {
  sections: TutorialSection[];
};

const { sections } = Astro.props;

const toc = sections.filter((s) => s.blocks.length > 0);
---

<div class="tutorial-guide lg:grid lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-10">
  <div class="tutorial-sections min-w-0 space-y-6">
    {
      toc.map((section) => {
        const summaryEn = getTutorialSectionSummaryEn(section);
        const summaryKm = section.summaryVi ? getTutorialSectionSummaryKm(section) : undefined;
        return (
        <section
          id={`hub-${section.anchor}`}
          class:list={[
            'card scroll-mt-24 p-5 md:p-6',
            section.level === 3 && 'ml-0 border-l-2 border-[var(--cf-accent)]/35 pl-4 md:ml-2 md:pl-5',
          ]}
        >
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              {section.level === 2 ? (
                <h2 class="text-lg font-semibold leading-snug md:text-xl">
                  <span class="lang-vi">{section.titleVi ?? section.title}</span>
                  <span class="lang-en">{section.title}</span>
                  <span class="lang-km">{section.titleKm ?? section.title}</span>
                </h2>
              ) : (
                <h3 class="text-base font-semibold leading-snug">
                  <span class="lang-vi">{section.titleVi ?? section.title}</span>
                  <span class="lang-en">{section.title}</span>
                  <span class="lang-km">{section.titleKm ?? section.title}</span>
                </h3>
              )}
              {section.summaryVi ? (
                <p class="lang-vi mt-2 text-sm leading-relaxed text-[var(--cf-text)]">{section.summaryVi}</p>
              ) : null}
              {summaryEn ? (
                <p class="lang-en mt-2 text-sm leading-relaxed text-[var(--cf-text)]">{summaryEn}</p>
              ) : null}
              {summaryKm ? (
                <p class="lang-km mt-2 text-sm leading-relaxed text-[var(--cf-text)]">{summaryKm}</p>
              ) : null}
            </div>
            <a
              class="btn btn-secondary shrink-0 text-xs sm:text-sm"
              href={section.docUrl}
              target="_blank"
              rel="noopener noreferrer"
              title={section.title}
            >
              <LangText text={tutorialChrome.openSourceSection} />
            </a>
          </div>

          <div class="tutorial-body prose-learn mt-4 space-y-3 text-sm leading-relaxed">
            {section.blocks.map((block) => {
              if (block.type === 'paragraph') {
                return (
                  <>
                    <div class="lang-vi" set:html={block.htmlVi ?? block.html} />
                    <div class="lang-en" set:html={block.html} />
                    <div class="lang-km" set:html={block.htmlKm ?? block.html} />
                  </>
                );
              }
              if (block.type === 'note') {
                return (
                  <>
                    <aside class="lang-vi tutorial-inline-note" role="note">
                      <p class="tutorial-inline-note-kind">{tutorialChrome.notesKind.vi}</p>
                      <div class="font-bold" set:html={block.htmlVi ?? block.html} />
                    </aside>
                    <aside class="lang-en tutorial-inline-note" role="note">
                      <p class="tutorial-inline-note-kind">{tutorialChrome.notesKind.en}</p>
                      <div class="font-bold" set:html={block.html} />
                    </aside>
                    <aside class="lang-km tutorial-inline-note" role="note">
                      <p class="tutorial-inline-note-kind">{tutorialChrome.notesKind.km}</p>
                      <div class="font-bold" set:html={block.htmlKm ?? block.html} />
                    </aside>
                  </>
                );
              }
              if (block.type === 'list') {
                const Tag = block.ordered ? 'ol' : 'ul';
                const listClass = [block.ordered ? 'list-decimal' : 'list-disc', 'space-y-1 pl-5'];
                const viItems = block.itemsVi ?? block.items;
                const kmItems = block.itemsKm ?? block.items;
                return (
                  <>
                    <Tag class:list={[...listClass, 'lang-vi']}>
                      {viItems.map((item) => (
                        <li set:html={item} />
                      ))}
                    </Tag>
                    <Tag class:list={[...listClass, 'lang-en']}>
                      {block.items.map((item) => (
                        <li set:html={item} />
                      ))}
                    </Tag>
                    <Tag class:list={[...listClass, 'lang-km']}>
                      {kmItems.map((item) => (
                        <li set:html={item} />
                      ))}
                    </Tag>
                  </>
                );
              }
              if (block.type === 'code') {
                return (
                  <div class="overflow-x-auto rounded-lg border border-[var(--cf-border)] bg-[var(--cf-bg)]">
                    {block.language ? (
                      <div class="border-b border-[var(--cf-border)] px-3 py-1 text-[10px] uppercase tracking-wide text-[var(--cf-text-muted)]">
                        {block.language}
                      </div>
                    ) : null}
                    <pre class="tutorial-code p-3 text-xs leading-relaxed"><code>{block.code}</code></pre>
                  </div>
                );
              }
              return null;
            })}
          </div>

          {section.relatedLinks.length > 0 ? (
            <div class="mt-5 rounded-lg border border-[var(--cf-border)] bg-[var(--cf-bg-elevated)]/50 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-[var(--cf-accent)]">
                <LangText text={tutorialChrome.relatedLinks} />
              </p>
              <ul class="mt-2 space-y-1.5 text-sm">
                {section.relatedLinks.map((link) => (
                  <li>
                    <a class="link break-all" href={link.href} target="_blank" rel="noopener noreferrer">
                      {link.label} ↗
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
        </section>
        );
      })
    }

  </div>

  {toc.length > 2 ? (
    <aside class="hidden lg:block">
      <nav
        class="sticky top-20 rounded-xl border border-[var(--cf-border)] bg-[var(--cf-bg-elevated)]/80 p-4 backdrop-blur-sm"
        aria-label="Tutorial table of contents"
      >
        <p class="text-xs font-semibold uppercase tracking-wide text-[var(--cf-text-muted)]">
          <LangText text={tutorialChrome.toc} />
        </p>
        <ol class="mt-3 max-h-[70vh] space-y-1 overflow-y-auto text-xs">
          {toc.map((section) => (
            <li class:list={[section.level === 3 && 'ml-3']}>
              <a class="link block py-0.5 leading-snug" href={`#hub-${section.anchor}`}>
                <span class="lang-vi">{section.titleVi ?? section.title}</span>
                <span class="lang-en">{section.title}</span>
                <span class="lang-km">{section.titleKm ?? section.title}</span>
              </a>
              <a
                class="text-muted mt-0.5 block text-[10px] opacity-70 hover:opacity-100"
                href={section.docUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <LangText text={tutorialChrome.docsGoc} />
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  ) : null}
</div>

<style>
  .tutorial-inline-note {
    border-radius: 0.85rem;
    border: 1px solid color-mix(in srgb, var(--cf-accent) 45%, var(--cf-border));
    border-left-width: 5px;
    border-left-color: var(--cf-accent);
    background: color-mix(in srgb, var(--cf-accent) 12%, var(--cf-bg));
    padding: 0.85rem 1rem;
  }

  .tutorial-inline-note-kind {
    display: inline-flex;
    margin: 0 0 0.45rem;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    padding: 0.14rem 0.5rem;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .tutorial-code {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .tutorial-body :global(.tutorial-inline-code) {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    background: var(--cf-bg-elevated);
    border: 1px solid var(--cf-border);
  }
</style>
