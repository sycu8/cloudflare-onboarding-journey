---
import LangText from '../ui/LangText.astro';
import type { LocalizedString } from '../../i18n/types';

type Props = {
  title: LocalizedString;
  description: LocalizedString;
};

const { title, description } = Astro.props;
---

<div class="card h-full">
  <LangText as="h3" class="text-lg font-semibold" text={title} />
  <LangText as="p" class="text-muted mt-2 text-sm" text={description} />
</div>

