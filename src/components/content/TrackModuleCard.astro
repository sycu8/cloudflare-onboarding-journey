---
import LangText from '../ui/LangText.astro';
import type { TrackModule, TrackModuleRole } from '../../data/tracks';

const roleLabel: Record<TrackModuleRole, { vi: string; en: string; km: string }> = {
  required: { vi: 'Bắt buộc', en: 'Required', km: 'ចាំបាច់' },
  recommended: { vi: 'Khuyến nghị', en: 'Recommended', km: 'ណែនាំ' },
  optional: { vi: 'Tùy chọn', en: 'Optional', km: 'ស្រេចចិត្ត' },
  'deep-dive': { vi: 'Đi sâu', en: 'Deep-dive', km: 'សិក្សាស៊ីជម្រៅ' },
  reference: { vi: 'Tham chiếu', en: 'Reference', km: 'ឯកសារយោង' },
};

type Props = {
  module: TrackModule;
  trackSlug: string;
};

const { module, trackSlug } = Astro.props;
---

<article class="card">
  <div class="flex flex-wrap items-center gap-2">
    {module.role ? (
      <span class="badge badge-accent">
        <span class="lang-vi">{roleLabel[module.role].vi}</span>
        <span class="lang-en">{roleLabel[module.role].en}</span>
        <span class="lang-km">{roleLabel[module.role].km}</span>
      </span>
    ) : null}
    {module.duration ? <span class="badge"><LangText text={module.duration} /></span> : null}
    <span class="badge">
      <span class="lang-vi">{module.lessons.length} bài</span>
      <span class="lang-en">{module.lessons.length} lessons</span>
      <span class="lang-km">{module.lessons.length} មេរៀន</span>
    </span>
  </div>

  <LangText as="h3" class="mt-3 text-lg font-semibold" text={module.title} />
  <LangText as="p" class="text-muted mt-2 text-sm" text={module.description} />

  <ol class="mt-4 space-y-4">
    {module.lessons.map((lesson, li) => {
      const lessonId = `${module.id}-l${li + 1}`;
      return (
      <li class="rounded-xl border border-[var(--cf-border)] bg-[var(--cf-bg-elevated)]/50 p-4">
        <div class="flex gap-3">
          <span class="badge badge-accent mt-0.5 shrink-0">{li + 1}</span>
          <div class="min-w-0 flex-1">
            <a href={`/tracks/${trackSlug}/${lessonId}`} class="group">
              <LangText as="h4" class="font-medium group-hover:text-[var(--cf-accent)]" text={lesson.title} />
            </a>
            <LangText as="p" class="text-muted mt-2 text-sm leading-relaxed" text={lesson.body} />
            {lesson.tip ? (
              <p class="mt-2 rounded-lg border border-[var(--cf-border)] bg-[var(--cf-surface)] px-3 py-2 text-xs">
                <span class="font-medium text-[var(--cf-accent)]">
                  <span class="lang-vi">Mẹo: </span>
                  <span class="lang-en">Tip: </span>
                  <span class="lang-km">គន្លឹះ៖ </span>
                </span>
                <span class="lang-vi">{lesson.tip.vi}</span>
                <span class="lang-en">{lesson.tip.en}</span>
                <span class="lang-km">{lesson.tip.km ?? lesson.tip.en}</span>
              </p>
            ) : null}
            <a class="link mt-3 inline-block text-sm" href={`/tracks/${trackSlug}/${lessonId}`}>
              <span class="lang-vi">Hướng dẫn chi tiết →</span>
              <span class="lang-en">Detailed guide →</span>
              <span class="lang-km">មគ្គុទេសក៍លម្អិត →</span>
            </a>
          </div>
        </div>
      </li>
    );})}
  </ol>
</article>
