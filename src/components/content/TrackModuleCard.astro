---
import LangText from '../ui/LangText.astro';
import LessonKindBadge from './LessonKindBadge.astro';
import type { TrackModule, TrackModuleRole } from '../../data/tracks';
import type { FlowItem } from '../../data/trackFlow';

const roleLabel: Record<TrackModuleRole, { vi: string; en: string; km: string }> = {
  required: { vi: 'Bắt buộc', en: 'Required', km: 'ចាំបាច់' },
  recommended: { vi: 'Khuyến nghị', en: 'Recommended', km: 'ណែនាំ' },
  optional: { vi: 'Tùy chọn', en: 'Optional', km: 'ស្រេចចិត្ត' },
  'deep-dive': { vi: 'Đi sâu', en: 'Deep-dive', km: 'សិក្សាស៊ីជម្រៅ' },
  reference: { vi: 'Tham chiếu', en: 'Reference', km: 'ឯកសារយោង' },
};

type Props = {
  module: TrackModule;
  flow: FlowItem[];
};

const { module, flow } = Astro.props;
const items = flow.filter((item) => item.moduleId === module.id);
const byKey = new Map(flow.map((item) => [item.key, item]));
---

<article class="card" id={module.id}>
  <div class="flex flex-wrap items-center gap-2">
    {module.role ? (
      <span class="badge badge-accent">
        <span class="lang-vi">{roleLabel[module.role].vi}</span>
        <span class="lang-en">{roleLabel[module.role].en}</span>
        <span class="lang-km">{roleLabel[module.role].km}</span>
      </span>
    ) : null}
    {module.duration ? <span class="badge"><LangText text={module.duration} /></span> : null}
    <span class="badge">
      <span class="lang-vi">{module.lessons.length} bài</span>
      <span class="lang-en">{module.lessons.length} lessons</span>
      <span class="lang-km">{module.lessons.length} lessons</span>
    </span>
  </div>

  <LangText as="h3" class="mt-3 text-lg font-semibold" text={module.title} />
  <LangText as="p" class="text-muted mt-2 text-sm" text={module.description} />

  <ol class="mt-4 divide-y divide-[var(--cf-border)]">
    {items.map((item) => {
      const prereqs = item.prerequisiteIds
        .map((id) => byKey.get(id))
        .filter((entry): entry is FlowItem => !!entry);
      return (
        <li class="py-3 first:pt-0 last:pb-0">
          <div class="flex flex-wrap items-center gap-2">
            <LessonKindBadge kind={item.kind} />
            {item.duration ? (
              <span class="badge">
                <LangText text={item.duration} />
              </span>
            ) : null}
          </div>
          <a href={item.href} class="group mt-2 inline-block">
            <LangText as="h4" class="font-medium group-hover:text-[var(--cf-accent)]" text={item.title} />
          </a>
          {item.summary ? (
            <LangText as="p" class="text-muted mt-1 text-sm leading-relaxed" text={item.summary} />
          ) : null}
          {prereqs.length > 0 ? (
            <p class="text-muted mt-2 text-xs leading-relaxed">
              <span class="lang-vi">Nên đọc trước: </span>
              <span class="lang-en">Read first: </span>
              <span class="lang-km">Read first: </span>
              {prereqs.map((prereq, index) => (
                <>
                  {index > 0 ? <span>, </span> : null}
                  <a class="link" href={prereq.href}>
                    <LangText text={prereq.title} />
                  </a>
                </>
              ))}
            </p>
          ) : null}
        </li>
      );
    })}
  </ol>
</article>
