---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/chrome/Breadcrumbs.astro';
import LangText from '../components/ui/LangText.astro';
import ResourceCard from '../components/content/ResourceCard.astro';
import CloudsecopSeriesCard from '../components/content/CloudsecopSeriesCard.astro';
import CloudsecopArticleGrid from '../components/interactive/CloudsecopArticleGrid';
import LearningTopicGrid from '../components/interactive/LearningTopicGrid';
import GitHubRepoCard from '../components/content/GitHubRepoCard.astro';
import GitHubLearningPathCard from '../components/content/GitHubLearningPathCard.astro';
import ReferenceArchitectureCard from '../components/content/ReferenceArchitectureCard.astro';
import ReferenceDiagramCard from '../components/content/ReferenceDiagramCard.astro';
import ReferenceDiagramGrid from '../components/interactive/ReferenceDiagramGrid';
import {
  REF_ARCH_DIAGRAMS_URL,
  DIAGRAMS_LAST_SYNCED,
  getFeaturedDiagrams,
  referenceDiagrams,
} from '../data/referenceDiagrams';
import ResourceHubCard from '../components/content/ResourceHubCard.astro';
import { resources } from '../data/resources';
import {
  resourceHubIntro,
  resourceHubItems,
  CLOUDFLARE_RESOURCE_HUB_URL,
  getFeaturedResourceHubItems,
  getResourceHubByCategory,
  resourceHubCategoryLabels,
  type ResourceHubCategory,
} from '../data/resourceHub';
import {
  referenceArchitectureIntro,
  referenceArchitectureItems,
  REFERENCE_ARCHITECTURE_HUB_URL,
  REFERENCE_ARCHITECTURE_DOCS_URL,
  getFeaturedReferenceItems,
  getReferenceItemsByType,
  type ReferenceDocType,
} from '../data/referenceArchitecture';
import {
  githubRepos,
  githubIntro,
  githubLearningPaths,
  githubCategories,
  CLOUDFLARE_GITHUB_ORG,
  getGitHubReposByCategory,
  type GitHubRepoCategory,
} from '../data/githubRepos';
import { learningTopics, learningCenterIntro } from '../data/learningCenter';
import {
  cloudsecopArticles,
  cloudsecopSeries,
  cloudsecopIntro,
  CLOUDSECOP_TAG_URL,
} from '../data/cloudsecop';
import CloudflareResourceGrid from '../components/interactive/CloudflareResourceGrid';
import {
  cloudflareResources,
  CLOUDFLARE_RESOURCES_URL,
  RESOURCES_LAST_SYNCED,
} from '../data/cloudflareResources';
import { blogPosts, blogPostPath, blogTopicLabels } from '../data/blog';

const featuredBlog = blogPosts.slice(0, 4);
---

<BaseLayout
  title={{ vi: 'Tài nguyên học Cloudflare', en: 'Cloudflare learning resources', km: 'Cloudflare learning resources' }}
  description={{
    vi: 'Tài nguyên học Cloudflare: Blog, Resource Hub, Reference Architecture, GitHub, Learning Center, CloudSecOp — có lọc và phân trang cho danh sách dài.',
    en: 'Cloudflare learning resources: Blog, Resource Hub, Reference Architecture, GitHub, Learning Center, CloudSecOp — with filters and pagination.',
  }}
  canonicalPath="/resources"
  showProgressBar
>
  <Breadcrumbs items={[{ href: '/resources', label: { vi: 'Tài nguyên', en: 'Resources' , km: 'Resources' } }]} />

  <header class="mb-8">
    <LangText as="h1" class="text-2xl font-semibold md:text-3xl" text={{ vi: 'Tài nguyên học Cloudflare', en: 'Cloudflare learning resources', km: 'Cloudflare learning resources' }} />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-sm md:text-base" text={resourceHubIntro} />
    <p class="text-muted mt-2 text-xs">
      <a class="link" href={CLOUDFLARE_RESOURCE_HUB_URL} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">Cloudflare Resource Hub (chính thức) ↗</span>
        <span class="lang-en">Official Cloudflare Resource Hub ↗</span>
        <span class="lang-km">Official Cloudflare Resource Hub ↗</span>
      </a>
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      <a class="btn btn-primary" href="/blog/">
        <LangText text={{ vi: 'Đọc Blog →', en: 'Read the Blog →' }} />
      </a>
      <a class="btn btn-secondary" href="#blog">
        <LangText text={{ vi: 'Bài mới trên hub', en: 'Latest hub posts' }} />
      </a>
    </div>
  </header>

  <section id="blog" class="card mb-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'Blog học Cloudflare', en: 'Cloudflare learning blog' }} />
        <LangText
          as="p"
          class="text-muted mt-1 text-sm"
          text={{
            vi: 'Bài viết entry & intermediate về AI, Security, CDN, Workers và Developer Platform — viết lại dễ hiểu từ blog.cloudflare.com, có FAQ và liên kết học tiếp trên hub.',
            en: 'Entry & intermediate posts on AI, Security, CDN, Workers, and the Developer Platform — plain-language rewrites from blog.cloudflare.com, with FAQs and hub next steps.',
          }}
        />
      </div>
      <a class="btn btn-primary shrink-0" href="/blog/">
        <LangText text={{ vi: 'Xem tất cả bài', en: 'View all posts' }} />
      </a>
    </div>
    <ul class="mt-4 divide-y divide-[var(--cf-border)] border-t border-[var(--cf-border)]">
      {
        featuredBlog.map((post) => (
          <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
            <div class="min-w-0">
              <a class="link font-medium" href={blogPostPath(post.slug)}>
                <LangText text={post.title} />
              </a>
              <p class="text-muted mt-1 text-xs">
                <LangText text={blogTopicLabels[post.topic]} />
                <span aria-hidden="true"> · </span>
                <time datetime={post.date}>{post.date}</time>
              </p>
            </div>
            <a class="btn btn-secondary shrink-0 self-start text-sm" href={blogPostPath(post.slug)}>
              <LangText text={{ vi: 'Đọc', en: 'Read' }} />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="card mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'Tuần đầu & cập nhật 2026', en: 'First week & 2026 updates', km: 'First week & 2026 updates' }} />
      <LangText
        as="p"
        class="text-muted mt-1 text-sm"
        text={{
          vi: 'Lộ trình 7 ngày, sai lầm thường gặp và snapshot sản phẩm mới — đối chiếu trước khi học tên cũ.',
          en: '7-day path, common mistakes, and new product snapshot — cross-check before learning outdated names.',
        }}
      />
    </div>
    <a class="btn btn-primary shrink-0" href="/first-week">
      <LangText text={{ vi: 'Mở lộ trình tuần đầu', en: 'Open first-week plan', km: 'Open first-week plan' }} />
    </a>
  </section>

  <section id="changelog" class="card mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'Changelog sản phẩm', en: 'Product changelog', km: 'Product changelog' }} />
      <LangText
        as="p"
        class="text-muted mt-1 text-sm"
        text={{
          vi: 'Nguồn chính thức developers.cloudflare.com/changelog — tóm tắt Agents, Workers, Cloudflare One, R2, security; có RSS.',
          en: 'Official source developers.cloudflare.com/changelog — curated Agents, Workers, Cloudflare One, R2, security updates; RSS linked.',
        }}
      />
    </div>
    <a class="btn btn-primary shrink-0" href="/changelog">
      <LangText text={{ vi: 'Xem changelog', en: 'View changelog', km: 'View changelog' }} />
    </a>
  </section>

  <section id="system-status" class="card mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'System status & incidents', en: 'System status & incidents', km: 'System status & incidents' }} />
      <LangText
        as="p"
        class="text-muted mt-1 text-sm"
        text={{
          vi: 'Nguồn chính thức new.cloudflarestatus.com — sự cố active, maintenance, lịch sử; tải live qua API.',
          en: 'Official source new.cloudflarestatus.com — active incidents, maintenance, history; live API in the hub.',
        }}
      />
    </div>
    <a class="btn btn-primary shrink-0" href="/status">
      <LangText text={{ vi: 'Xem system status', en: 'View system status', km: 'View system status' }} />
    </a>
  </section>

  <section id="content-delivery" class="card mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'Content delivery & tăng tốc web', en: 'Content delivery & web performance', km: 'Content delivery & web performance' }} />
      <LangText
        as="p"
        class="text-muted mt-1 text-sm"
        text={{
          vi: 'CDN, Cache Rules, Argo, Speed, Images — checklist thực hành và sai lầm thường gặp.',
          en: 'CDN, Cache Rules, Argo, Speed, Images — hands-on checklist and common mistakes.',
        }}
      />
    </div>
    <a class="btn btn-primary shrink-0" href="/content-delivery">
      <LangText text={{ vi: 'Mở hướng dẫn', en: 'Open guide', km: 'Open guide' }} />
    </a>
  </section>

  <section id="solution-proposals" class="card mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'Proposal bộ giải pháp', en: 'Solution proposals', km: 'Solution proposals' }} />
      <LangText
        as="p"
        class="text-muted mt-1 text-sm"
        text={{
          vi: 'Application Security, SASE (Cloudflare One), Email Security — song ngữ Anh–Việt, rút gọn từ proposal mẫu.',
          en: 'Application Security, SASE (Cloudflare One), Email Security — bilingual EN/VI from sample proposals.',
        }}
      />
    </div>
    <a class="btn btn-primary shrink-0" href="/solutions">
      <LangText text={{ vi: 'Xem 3 bộ giải pháp', en: 'View 3 solutions', km: 'View 3 solutions' }} />
    </a>
  </section>

  <section id="demo-guides" class="card mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'Dashboard overview', en: 'Dashboard overview', km: 'Dashboard overview' }} />
      <LangText
        as="p"
        class="text-muted mt-1 text-sm"
        text={{
          vi: 'Application Security & Cloudflare One — từng mục dashboard (WAF, Bot, API Shield, Access, Gateway, WARP) dùng để làm gì.',
          en: 'Application Security & Cloudflare One — what each dashboard area (WAF, Bot, API Shield, Access, Gateway, WARP) is for.',
        }}
      />
    </div>
    <a class="btn btn-primary shrink-0" href="/demo-guides">
      <LangText text={{ vi: 'Mở dashboard overview', en: 'Open dashboard overview', km: 'Open dashboard overview' }} />
    </a>
  </section>

  <section id="plan-comparison" class="card mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'So sánh gói cho SME', en: 'Plan comparison for SMEs', km: 'Plan comparison for SMEs' }} />
      <LangText
        as="p"
        class="text-muted mt-1 text-sm"
        text={{
          vi: 'Free / Pro / Business / Enterprise — 124 tính năng, hướng chọn Business hoặc Enterprise khi mua cho doanh nghiệp.',
          en: 'Free / Pro / Business / Enterprise — 124 features, guidance for Business vs Enterprise purchases.',
        }}
      />
    </div>
    <a class="btn btn-primary shrink-0" href="/plans">
      <LangText text={{ vi: 'Xem bảng so sánh', en: 'View comparison', km: 'View comparison' }} />
    </a>
  </section>

  <section id="resource-hub" class="mb-10">
    <LangText
      as="h2"
      class="text-xl font-semibold"
      text={{ vi: 'Cloudflare Resource Hub', en: 'Cloudflare Resource Hub', km: 'Cloudflare Resource Hub' }}
    />
    <LangText
      as="p"
      class="text-muted mt-2 max-w-3xl text-sm leading-relaxed"
      text={{
        vi: 'Bản đồ tài nguyên chính thức — dưới đây là các mục quan trọng nhất cho người mới, có link trực tiếp hoặc trỏ về phần tương ứng trong Starter Hub.',
        en: 'The official resource map — below are the most important items for beginners, with direct links or pointers to matching sections in this Starter Hub.',
      }}
    />

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {getFeaturedResourceHubItems(6).map((item) => (
        <ResourceHubCard item={item} />
      ))}
    </div>

    {
      (['learn', 'build', 'community', 'operations', 'explore'] as ResourceHubCategory[]).map((category) => {
        const items = getResourceHubByCategory(category).filter((i) => !i.featured);
        if (items.length === 0) return null;
        return (
          <div class="mt-10">
            <LangText as="h3" class="text-lg font-semibold" text={resourceHubCategoryLabels[category]} />
            <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {items.map((item) => (
                <ResourceHubCard item={item} />
              ))}
            </div>
          </div>
        );
      })
    }

    <p class="text-muted mt-6 text-sm">
      <span class="lang-vi">{resourceHubItems.length} mục được tổ chức lại tại đây. </span>
      <span class="lang-en">{resourceHubItems.length} items reorganized here. </span>
      <span class="lang-km">{resourceHubItems.length} items reorganized here.</span>
      <a class="link" href={CLOUDFLARE_RESOURCE_HUB_URL} target="_blank" rel="noopener noreferrer">
        <LangText text={{ vi: 'Xem toàn bộ Resource Hub', en: 'View full Resource Hub', km: 'View full Resource Hub' }} /> ↗
      </a>
    </p>
  </section>

  <section id="cloudflare-resources" class="mb-10">
    <LangText
      as="h2"
      class="text-xl font-semibold"
      text={{ vi: 'Ví dụ triển khai (Cloudflare Resources)', en: 'Deployment examples (Cloudflare Resources)', km: 'Deployment examples (Cloudflare Resources)' }}
    />
    <LangText
      as="p"
      class="text-muted mt-2 max-w-3xl text-sm leading-relaxed"
      text={{
        vi: `Catalog chính thức từ developers.cloudflare.com/resources — ${cloudflareResources.length} tutorial, solution guide, reference architecture và video (đồng bộ ${RESOURCES_LAST_SYNCED}). Lọc theo lộ trình hub hoặc loại nội dung.`,
        en: `Official catalog from developers.cloudflare.com/resources — ${cloudflareResources.length} tutorials, solution guides, reference architectures, and videos (synced ${RESOURCES_LAST_SYNCED}). Filter by hub track or content type.`,
      }}
    />
    <p class="text-muted mt-2 text-xs">
      <span class="lang-vi">
        Đang theo một lộ trình? Catalog đã lọc theo track nằm tại{' '}
        <a class="link" href="/tracks/application-services#track-resources">Application Services</a>,{' '}
        <a class="link" href="/tracks/developer-platform#track-resources">Developer Platform</a>, hoặc{' '}
        <a class="link" href="/tracks/cloudflare-one#track-resources">Cloudflare One</a>.
      </span>
      <span class="lang-en">
        Following a learning path? Filtered catalogs live on{' '}
        <a class="link" href="/tracks/application-services#track-resources">Application Services</a>,{' '}
        <a class="link" href="/tracks/developer-platform#track-resources">Developer Platform</a>, or{' '}
        <a class="link" href="/tracks/cloudflare-one#track-resources">Cloudflare One</a>.
      </span>
      <span class="lang-km">Following a learning path? Filtered catalogs live on{' '}
        <a class="link" href="/tracks/application-services#track-resources">Application Services</a>,{' '}
        <a class="link" href="/tracks/developer-platform#track-resources">Developer Platform</a>, or{' '}
        <a class="link" href="/tracks/cloudflare-one#track-resources">Cloudflare One</a>.</span>
      {' · '}
      <a class="link" href={CLOUDFLARE_RESOURCES_URL} target="_blank" rel="noopener noreferrer">
        <LangText text={{ vi: 'Cloudflare Docs ↗', en: 'Cloudflare Docs ↗', km: 'Cloudflare Docs ↗' }} />
      </a>
    </p>
    <div class="mt-6">
      <CloudflareResourceGrid client:load resources={cloudflareResources} />
    </div>
  </section>

  <section class="mb-10">
    <LangText as="h2" class="text-xl font-semibold" text={{ vi: 'Công cụ tương tác trong hub', en: 'Interactive tools in this hub', km: 'Interactive tools in this hub' }} />
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {resources.map((r) => (
        <ResourceCard title={r.title} description={r.description} type={r.type} href={r.href} status={r.status} />
      ))}
    </div>
  </section>

  <section id="github" class="mb-10">
    <LangText
      as="h2"
      class="text-xl font-semibold"
      text={{ vi: 'Open source trên GitHub', en: 'Open source on GitHub', km: 'Open source on GitHub' }}
    />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-sm leading-relaxed" text={githubIntro} />
    <p class="text-muted mt-2 text-xs">
      <a class="link" href={CLOUDFLARE_GITHUB_ORG} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">Tổ chức cloudflare trên GitHub (560+ repo) ↗</span>
        <span class="lang-en">cloudflare organization on GitHub (560+ repos) ↗</span>
        <span class="lang-km">cloudflare organization on GitHub (560+ repos) ↗</span>
      </a>
    </p>

    <LangText
      as="h3"
      class="mt-8 text-lg font-semibold"
      text={{ vi: 'Lộ trình ví dụ — học qua repo', en: 'Example paths — learn from repos', km: 'Example paths — learn from repos' }}
    />
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {githubLearningPaths.map((path) => (
        <GitHubLearningPathCard path={path} />
      ))}
    </div>

    {
      (['workers', 'zero-trust', 'ai', 'docs', 'infrastructure', 'examples'] as GitHubRepoCategory[]).map(
        (category) => {
          const repos = getGitHubReposByCategory(category);
          if (repos.length === 0) return null;
          const meta = githubCategories[category];
          return (
            <div class="mt-10" id={category}>
              <LangText as="h3" class="text-lg font-semibold" text={meta.label} />
              <LangText as="p" class="text-muted mt-1 text-sm" text={meta.description} />
              <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                {repos.map((repo) => (
                  <GitHubRepoCard repo={repo} />
                ))}
              </div>
            </div>
          );
        },
      )
    }

    <p class="text-muted mt-6 text-sm">
      <span class="lang-vi">Đang hiển thị {githubRepos.length} repo được chọn lọc. </span>
      <span class="lang-en">Showing {githubRepos.length} curated repos. </span>
      <span class="lang-km">Showing {githubRepos.length} curated repos.</span>
      <a class="link" href={CLOUDFLARE_GITHUB_ORG} target="_blank" rel="noopener noreferrer">
        <LangText text={{ vi: 'Khám phá thêm trên GitHub', en: 'Explore more on GitHub', km: 'Explore more on GitHub' }} /> ↗
      </a>
    </p>
  </section>

  <section id="reference-diagrams" class="mb-10">
    <LangText
      as="h2"
      class="text-xl font-semibold"
      text={{ vi: 'Sơ đồ kiến trúc (Reference Diagrams)', en: 'Reference architecture diagrams', km: 'Reference architecture diagrams' }}
    />
    <p class="text-muted mt-2 max-w-3xl text-sm leading-relaxed">
      <span class="lang-vi">
        Hình ảnh và pattern chính thức từ developers.cloudflare.com/reference-architecture/diagrams — AI, CDN, SASE, Serverless, Security, Storage. Hub đồng bộ {referenceDiagrams.length} sơ đồ (review {DIAGRAMS_LAST_SYNCED}).
      </span>
      <span class="lang-en">
        Official figures and patterns from developers.cloudflare.com/reference-architecture/diagrams — AI, CDN, SASE, Serverless, Security, Storage. This hub mirrors {referenceDiagrams.length} diagrams (review {DIAGRAMS_LAST_SYNCED}).
      </span>
      <span class="lang-km">Official figures and patterns from developers.cloudflare.com/reference-architecture/diagrams — AI, CDN, SASE, Serverless, Security, Storage. This hub mirrors {referenceDiagrams.length} diagrams (review {DIAGRAMS_LAST_SYNCED}).</span>
    </p>
    <p class="text-muted mt-2 text-xs">
      <a class="link" href={REF_ARCH_DIAGRAMS_URL} target="_blank" rel="noopener noreferrer">
        <LangText text={{ vi: 'Mở thư viện sơ đồ ↗', en: 'Open diagram library ↗', km: 'Open diagram library ↗' }} />
      </a>
    </p>

    <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {getFeaturedDiagrams(4).map((d) => (
        <ReferenceDiagramCard diagram={d} />
      ))}
    </div>

    <div class="mt-10">
      <ReferenceDiagramGrid client:load diagrams={referenceDiagrams} />
    </div>
  </section>

  <section id="reference-architecture" class="mb-10">
    <LangText
      as="h2"
      class="text-xl font-semibold"
      text={{ vi: 'Reference Architecture', en: 'Reference Architecture', km: 'Reference Architecture' }}
    />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-sm leading-relaxed" text={referenceArchitectureIntro} />
    <p class="text-muted mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs">
      <a class="link" href={REFERENCE_ARCHITECTURE_HUB_URL} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">Architecture Center ↗</span>
        <span class="lang-en">Architecture Center ↗</span>
        <span class="lang-km">Architecture Center ↗</span>
      </a>
      <a class="link" href={REFERENCE_ARCHITECTURE_DOCS_URL} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">Tài liệu kỹ thuật (developers) ↗</span>
        <span class="lang-en">Technical docs (developers) ↗</span>
        <span class="lang-km">Technical docs (developers) ↗</span>
      </a>
      <a class="link" href="#reference-diagrams">
        <LangText text={{ vi: 'Sơ đồ có hình ↗', en: 'Diagram gallery ↗', km: 'Diagram gallery ↗' }} />
      </a>
    </p>

    <LangText
      as="h3"
      class="mt-8 text-lg font-semibold"
      text={{ vi: 'Bắt đầu từ đây', en: 'Start here', km: 'Start here' }}
    />
    <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {getFeaturedReferenceItems(6).map((item) => (
        <ReferenceArchitectureCard item={item} />
      ))}
    </div>

    {
      (
        ['reference-architecture', 'diagram', 'design-guide', 'implementation-guide'] as ReferenceDocType[]
      ).map((docType) => {
        const items = getReferenceItemsByType(docType).filter((i) => !i.featured);
        if (items.length === 0) return null;
        return (
          <div class="mt-10">
            <LangText
              as="h3"
              class="text-lg font-semibold"
              text={
                docType === 'reference-architecture'
                  ? { vi: 'Kiến trúc tham chiếu', en: 'Reference architectures', km: 'Reference architectures' }
                  : docType === 'diagram'
                    ? { vi: 'Sơ đồ kiến trúc', en: 'Architecture diagrams', km: 'Architecture diagrams' }
                    : docType === 'design-guide'
                      ? { vi: 'Hướng dẫn thiết kế', en: 'Design guides', km: 'Design guides' }
                      : { vi: 'Hướng dẫn triển khai', en: 'Implementation guides', km: 'Implementation guides' }
              }
            />
            <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {items.map((item) => (
                <ReferenceArchitectureCard item={item} />
              ))}
            </div>
          </div>
        );
      })
    }

    <p class="text-muted mt-6 text-sm">
      <span class="lang-vi">Đang hiển thị {referenceArchitectureItems.length} tài liệu chọn lọc. </span>
      <span class="lang-en">Showing {referenceArchitectureItems.length} curated documents. </span>
      <span class="lang-km">Showing {referenceArchitectureItems.length} curated documents.</span>
      <a class="link" href={REFERENCE_ARCHITECTURE_HUB_URL} target="_blank" rel="noopener noreferrer">
        <LangText text={{ vi: 'Duyệt toàn bộ trên Cloudflare', en: 'Browse all on Cloudflare', km: 'Browse all on Cloudflare' }} /> ↗
      </a>
    </p>
  </section>

