---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/chrome/Breadcrumbs.astro';
import LangText from '../../components/ui/LangText.astro';
import CTASection from '../../components/content/CTASection.astro';
import EnterpriseSuccessPackagesTable from '../../components/interactive/EnterpriseSuccessPackagesTable';
import { CONTACT_SALES_URL } from '../../data/enterprise';
import {
  SUCCESS_PACKAGES_SOURCE_NOTE,
  standardVsPremiumSummary,
  successAddOnServices,
  successPackageCategories,
  successPackageTiers,
  successPackagesPageIntro,
  successPackagesRegionNote,
} from '../../data/enterpriseSuccessPackages';
---

<BaseLayout
  title={{
    vi: 'Enterprise: Standard & Premium Success Packages',
    en: 'Enterprise: Standard & Premium Success Packages',
  }}
  description={{
    vi: 'Bảng so sánh Standard Success (đi kèm Enterprise) và Premium Success (3 tier theo ACV) — SLA support, CSM, onboarding, Asia & Latin America.',
    en: 'Compare Standard Success (included with Enterprise) and Premium Success (3 ACV tiers) — support SLAs, CSM, onboarding, Asia & Latin America.',
  }}
  canonicalPath="/cheatsheets/enterprise-support-success-packages"
  showProgressBar
>
  <Breadcrumbs
    items={[
      { href: '/resources', label: { vi: 'Tài nguyên', en: 'Resources' } },
      { href: '/enterprise', label: { vi: 'Enterprise', en: 'Enterprise' } },
      {
        href: '/cheatsheets/enterprise-support-success-packages',
        label: { vi: 'Standard & Premium Success', en: 'Standard & Premium Success' },
      },
    ]}
  />

  <header class="mb-8">
    <LangText
      as="h1"
      class="text-2xl font-semibold md:text-3xl"
      text={{ vi: 'Cloudflare Support & Success Packages', en: 'Cloudflare Support & Success Packages' }}
    />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-sm leading-relaxed md:text-base" text={successPackagesPageIntro} />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-xs leading-relaxed" text={successPackagesRegionNote} />
    <p class="mt-3 flex flex-wrap gap-3 text-sm">
      <a class="link" href="/enterprise">
        <span class="lang-vi">Trang Enterprise trên hub →</span>
        <span class="lang-en">Enterprise hub page →</span>
      </a>
      <a class="link" href="/cheatsheets/cloudflare-one-enterprise-vs-paygo">
        <span class="lang-vi">Cloudflare One Paygo vs Enterprise →</span>
        <span class="lang-en">Cloudflare One Paygo vs Enterprise →</span>
      </a>
      <a class="link" href={CONTACT_SALES_URL} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">Liên hệ Enterprise Sales ↗</span>
        <span class="lang-en">Contact Enterprise Sales ↗</span>
      </a>
    </p>
  </header>

  <section class="mb-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {
      successPackageTiers.map((tier) => (
        <article class="card flex h-full flex-col p-4">
          <LangText as="h2" class="text-lg font-semibold" text={tier.name} />
          <p class="badge-accent mt-2 text-xs">
            <span class="lang-vi">{tier.pricingHint.vi}</span>
            <span class="lang-en">{tier.pricingHint.en}</span>
          </p>
          {tier.acvRange ? (
            <p class="text-muted mt-2 text-xs">
              <span class="lang-vi">{tier.acvRange.vi}</span>
              <span class="lang-en">{tier.acvRange.en}</span>
            </p>
          ) : (
            <p class="text-muted mt-2 text-xs font-medium text-[var(--cf-accent)]">
              <span class="lang-vi">Đi kèm mọi hợp đồng Enterprise</span>
              <span class="lang-en">Included with every Enterprise contract</span>
            </p>
          )}
        </article>
      ))
    }
  </section>

  <section class="card mb-10 p-5">
    <LangText as="h2" class="text-lg font-semibold" text={standardVsPremiumSummary.title} />
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <div>
        <h3 class="text-sm font-medium">Standard</h3>
        <LangText as="p" class="text-muted mt-2 text-sm leading-relaxed" text={standardVsPremiumSummary.standard} />
      </div>
      <div>
        <h3 class="text-sm font-medium">Premium</h3>
        <LangText as="p" class="text-muted mt-2 text-sm leading-relaxed" text={standardVsPremiumSummary.premium} />
      </div>
    </div>
  </section>

  <section id="full-comparison" class="scroll-mt-24">
    <LangText
      as="h2"
      class="mb-2 text-xl font-semibold"
      text={{ vi: 'Bảng so sánh đầy đủ', en: 'Full comparison matrix' }}
    />
    <LangText
      as="p"
      class="text-muted mb-4 max-w-3xl text-sm"
      text={{
        vi: 'Mặc định lọc các dòng khác nhau giữa Standard và Premium. Premium tier 1–3 khác nhau chủ yếu ở expert sessions và mức tối ưu (webinar → focused → tailored).',
        en: 'Defaults to rows where Standard and Premium differ. Premium tiers 1–3 mainly differ on expert sessions and optimization depth (webinar → focused → tailored).',
      }}
    />
    <EnterpriseSuccessPackagesTable client:load categories={successPackageCategories} />
  </section>

  <section id="add-ons" class="mt-10 scroll-mt-24">
    <LangText as="h2" class="mb-4 text-xl font-semibold" text={{ vi: 'Dịch vụ bổ sung (add-on)', en: 'Optional add-on services' }} />
    <div class="grid gap-4 md:grid-cols-2">
      {
        successAddOnServices.map((svc) => (
          <article class="card p-4">
            <LangText as="h3" class="font-semibold" text={svc.title} />
            <LangText as="p" class="text-muted mt-2 text-sm leading-relaxed" text={svc.summary} />
          </article>
        ))
      }
    </div>
  </section>

  <aside class="card mt-8 border-dashed p-4 text-xs leading-relaxed" style="border-color: var(--cf-border)">
    <LangText as="p" class="text-muted" text={SUCCESS_PACKAGES_SOURCE_NOTE} />
  </aside>

  <CTASection
    title={{ vi: 'Cần báo giá Premium Success?', en: 'Need a Premium Success quote?' }}
    description={{
      vi: 'Standard đi kèm Enterprise; Premium và PS/TAM/SOCaaS là add-on — trao đổi với Sales hoặc đối tác Indochina để chọn tier và scope phù hợp.',
      en: 'Standard ships with Enterprise; Premium plus PS/TAM/SOCaaS are add-ons — talk to Sales or an Indochina partner to pick the right tier and scope.',
    }}
    cta={{ href: '/workshop', label: { vi: 'Đăng ký hội thảo', en: 'Workshop signup' } }}
  />
</BaseLayout>
