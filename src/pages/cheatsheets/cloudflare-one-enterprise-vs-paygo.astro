---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/chrome/Breadcrumbs.astro';
import LangText from '../../components/ui/LangText.astro';
import CTASection from '../../components/content/CTASection.astro';
import CloudflareOnePlanComparisonTable from '../../components/interactive/CloudflareOnePlanComparisonTable';
import {
  CLOUDFLARE_ONE_DASHBOARD_URL,
  CLOUDFLARE_ONE_PLANS_SOURCE_NOTE,
  CLOUDFLARE_ONE_PRICING_URL,
  CONTACT_SALES_URL,
  cloudflareOneDecisionGuide,
  cloudflareOneKeyDifferentiators,
  cloudflareOnePlanCategories,
  cloudflareOnePlanTierCards,
  cloudflareOnePlansPageIntro,
  cloudflareOnePaygoSupportWarning,
} from '../../data/cloudflareOnePlans';
---

<BaseLayout
  title={{
    vi: 'Cloudflare One: Pay-as-you-go vs Enterprise',
    en: 'Cloudflare One: Pay-as-you-go vs Enterprise',
  }}
  description={{
    vi: 'So sánh gói Pay-as-you-go ($7/user) và Contract Plan (Enterprise) cho Cloudflare One — ZTNA, SWG, DLP, CASB, SASE.',
    en: 'Compare Pay-as-you-go ($7/user) and Contract (Enterprise) plans for Cloudflare One — ZTNA, SWG, DLP, CASB, SASE.',
  }}
  canonicalPath="/cheatsheets/cloudflare-one-enterprise-vs-paygo"
  showProgressBar
>
  <Breadcrumbs
    items={[
      { href: '/resources', label: { vi: 'Tài nguyên', en: 'Resources' } },
      {
        href: '/cheatsheets/cloudflare-one-enterprise-vs-paygo',
        label: { vi: 'Cloudflare One: Paygo vs Enterprise', en: 'Cloudflare One: Paygo vs Enterprise' },
      },
    ]}
  />

  <header class="mb-8">
    <LangText
      as="h1"
      class="text-2xl font-semibold md:text-3xl"
      text={{ vi: 'Cloudflare One — Pay-as-you-go vs Enterprise', en: 'Cloudflare One — Pay-as-you-go vs Enterprise' }}
    />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-sm leading-relaxed md:text-base" text={cloudflareOnePlansPageIntro} />
    <p class="mt-3 flex flex-wrap gap-3 text-sm">
      <a class="link" href={CLOUDFLARE_ONE_PRICING_URL} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">Giá Zero Trust chính thức ↗</span>
        <span class="lang-en">Official Zero Trust pricing ↗</span>
      </a>
      <a class="link" href={CLOUDFLARE_ONE_DASHBOARD_URL} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">Zero Trust dashboard ↗</span>
        <span class="lang-en">Zero Trust dashboard ↗</span>
      </a>
      <a class="link" href={CONTACT_SALES_URL} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">Liên hệ Sales (Contract) ↗</span>
        <span class="lang-en">Contact Sales (Contract) ↗</span>
      </a>
      <a class="link" href="/plans">
        <span class="lang-vi">So sánh gói zone (Free–Enterprise) →</span>
        <span class="lang-en">Zone plan comparison (Free–Enterprise) →</span>
      </a>
    </p>
  </header>

  <section class="card mb-10 border-[var(--cf-accent)]/30 p-5" style="border-width: 1px;">
    <LangText as="h2" class="text-lg font-semibold text-[var(--cf-accent)]" text={cloudflareOnePaygoSupportWarning.title} />
    <LangText as="p" class="text-muted mt-2 text-sm leading-relaxed" text={cloudflareOnePaygoSupportWarning.body} />
    <ul class="text-muted mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed">
      {cloudflareOnePaygoSupportWarning.bullets.map((item) => (
        <li>
          <span class="lang-vi">{item.vi}</span>
          <span class="lang-en">{item.en}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mb-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {
      cloudflareOnePlanTierCards.map((tier) => (
        <article class="card flex h-full flex-col p-4">
          <div class="flex items-baseline justify-between gap-2">
            <LangText as="h2" class="text-lg font-semibold" text={tier.officialName} />
            <span class="badge-accent text-xs">
              <span class="lang-vi">{tier.pricingHint.vi}</span>
              <span class="lang-en">{tier.pricingHint.en}</span>
            </span>
          </div>
          <LangText as="p" class="text-muted mt-1 text-xs font-medium" text={tier.tagline} />
          <LangText as="p" class="text-muted mt-3 flex-1 text-sm leading-relaxed" text={tier.typicalBuyer} />
          {(tier.id === 'paygo' || tier.id === 'enterprise') && (
            <p class="mt-3 text-xs font-medium text-[var(--cf-accent)]">
              <span class="lang-vi">{tier.id === 'paygo' ? '← Self-serve sau Free tier' : '← Hợp đồng + add-on SASE'}</span>
              <span class="lang-en">{tier.id === 'paygo' ? '← Self-serve after Free tier' : '← Contract + SASE add-ons'}</span>
            </p>
          )}
        </article>
      ))
    }
  </section>

  <section class="mb-10 grid gap-6 lg:grid-cols-2">
    {
      cloudflareOneDecisionGuide.map((block) => (
        <div class="card p-5">
          <LangText as="h2" class="text-lg font-semibold" text={block.title} />
          <ul class="text-muted mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed">
            {block.bullets.map((b) => (
              <li>
                <span class="lang-vi">{b.vi}</span>
                <span class="lang-en">{b.en}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section id="key-differences" class="mb-10 scroll-mt-24">
    <LangText
      as="h2"
      class="mb-4 text-xl font-semibold"
      text={{ vi: 'Khác biệt then chốt: Pay-as-you-go vs Enterprise', en: 'Key differences: Pay-as-you-go vs Enterprise' }}
    />
    <div class="overflow-x-auto rounded-xl border" style="border-color: var(--cf-border)">
      <table class="w-full min-w-[640px] border-collapse text-sm">
        <thead>
          <tr class="border-b text-left text-xs uppercase tracking-wide" style="border-color: var(--cf-border); background: var(--cf-surface)">
            <th class="px-4 py-3">
              <span class="lang-vi">Tính năng</span>
              <span class="lang-en">Feature</span>
            </th>
            <th class="px-4 py-3">Pay-as-you-go</th>
            <th class="px-4 py-3">Enterprise</th>
            <th class="px-4 py-3">
              <span class="lang-vi">Vì sao quan trọng</span>
              <span class="lang-en">Why it matters</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            cloudflareOneKeyDifferentiators.map((row) => (
              <tr class="border-b align-top" style="border-color: var(--cf-border)">
                <td class="px-4 py-3 font-medium">
                  <span class="lang-vi">{row.feature.vi}</span>
                  <span class="lang-en">{row.feature.en}</span>
                </td>
                <td class="text-muted px-4 py-3">
                  <span class="lang-vi">{row.paygo.vi}</span>
                  <span class="lang-en">{row.paygo.en}</span>
                </td>
                <td class="px-4 py-3">
                  <span class="lang-vi">{row.enterprise.vi}</span>
                  <span class="lang-en">{row.enterprise.en}</span>
                </td>
                <td class="text-muted px-4 py-3 text-xs leading-relaxed">
                  <span class="lang-vi">{row.whyItMatters.vi}</span>
                  <span class="lang-en">{row.whyItMatters.en}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section id="full-comparison" class="scroll-mt-24">
    <LangText
      as="h2"
      class="mb-2 text-xl font-semibold"
      text={{ vi: 'Bảng so sánh đầy đủ (Free / Pay-as-you-go / Enterprise)', en: 'Full comparison (Free / Pay-as-you-go / Enterprise)' }}
    />
    <LangText
      as="p"
      class="text-muted mb-4 max-w-3xl text-sm"
      text={{
        vi: 'Mặc định lọc các dòng khác nhau giữa Pay-as-you-go và Enterprise. Bấm tên tính năng để xem ghi chú (nếu có).',
        en: 'Defaults to rows where Pay-as-you-go and Enterprise differ. Click a feature name to expand notes when available.',
      }}
    />
    <CloudflareOnePlanComparisonTable client:load categories={cloudflareOnePlanCategories} />
  </section>

  <aside class="card mt-8 border-dashed p-4 text-xs leading-relaxed" style="border-color: var(--cf-border)">
    <LangText as="p" class="text-muted" text={CLOUDFLARE_ONE_PLANS_SOURCE_NOTE} />
  </aside>

  <CTASection
    title={{ vi: 'Triển khai Cloudflare One', en: 'Deploy Cloudflare One' }}
    description={{
      vi: 'Theo lộ trình Cloudflare One từ account setup đến Gateway, DLP và (tùy chọn) Magic WAN.',
      en: 'Follow the Cloudflare One track from account setup through Gateway, DLP, and optional Magic WAN.',
    }}
    cta={{ href: '/tracks/cloudflare-one', label: { vi: 'Mở lộ trình Cloudflare One', en: 'Open Cloudflare One track' } }}
  />
</BaseLayout>
