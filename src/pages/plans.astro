---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/chrome/Breadcrumbs.astro';
import LangText from '../components/ui/LangText.astro';
import { OFFICIAL_PLANS_URL, PLANS_DOCS_URL, planTierCards, plansPageIntro } from '../data/cloudflarePlans';
---

<BaseLayout
  title={{
    vi: 'Gói Cloudflare: đọc trang chính thức',
    en: 'Cloudflare plans: read the official page',
    km: 'Cloudflare plans: read the official page',
  }}
  description={{
    vi: 'Hub không giữ bảng quyền lợi riêng. Free, Pro, Business và Contract được công bố tại cloudflare.com/plans.',
    en: 'This hub does not keep its own entitlement matrix. Free, Pro, Business, and Contract are published at cloudflare.com/plans.',
  }}
  canonicalPath="/plans"
  showProgressBar
>
  <Breadcrumbs
    items={[
      { href: '/resources', label: { vi: 'Tài nguyên', en: 'Resources', km: 'Resources' } },
      { href: '/plans', label: { vi: 'Gói Cloudflare', en: 'Cloudflare plans', km: 'Cloudflare plans' } },
    ]}
  />

  <header class="mb-8">
    <LangText
      as="h1"
      class="text-2xl font-semibold md:text-3xl"
      text={{ vi: 'Gói Cloudflare', en: 'Cloudflare plans', km: 'Cloudflare plans' }}
    />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-sm leading-relaxed md:text-base" text={plansPageIntro} />
    <p class="mt-4 flex flex-wrap gap-2">
      <a class="btn btn-primary" href={OFFICIAL_PLANS_URL} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">cloudflare.com/plans ↗</span>
        <span class="lang-en">cloudflare.com/plans ↗</span>
        <span class="lang-km">cloudflare.com/plans ↗</span>
      </a>
      <a class="btn btn-secondary" href={PLANS_DOCS_URL} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">Tài liệu tài khoản & billing ↗</span>
        <span class="lang-en">Account and billing docs ↗</span>
        <span class="lang-km">Account and billing docs ↗</span>
      </a>
    </p>
  </header>

  <section class="mb-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {
      planTierCards.map((tier) => (
        <article class="card flex h-full flex-col p-4">
          <LangText as="h2" class="text-lg font-semibold" text={tier.name} />
          <LangText as="p" class="text-muted mt-2 flex-1 text-sm leading-relaxed" text={tier.tagline} />
          <a class="link mt-3 text-xs" href={OFFICIAL_PLANS_URL} target="_blank" rel="noopener noreferrer">
            <span class="lang-vi">Xem trên trang gói ↗</span>
            <span class="lang-en">See the plans page ↗</span>
            <span class="lang-km">See the plans page ↗</span>
          </a>
        </article>
      ))
    }
  </section>

  <aside class="card border-dashed p-4 text-sm leading-relaxed" style="border-color: var(--cf-border)">
    <p>
      <span class="lang-vi">
        Nguồn: <a class="link" href={OFFICIAL_PLANS_URL}>https://www.cloudflare.com/plans/</a>. Nếu một bài học trên hub nói khác trang này, trang chính thức thắng.
      </span>
      <span class="lang-en">
        Source: <a class="link" href={OFFICIAL_PLANS_URL}>https://www.cloudflare.com/plans/</a>. If a lesson on this hub disagrees with that page, the official page wins.
      </span>
      <span class="lang-km">
        Source: <a class="link" href={OFFICIAL_PLANS_URL}>https://www.cloudflare.com/plans/</a>.
      </span>
    </p>
  </aside>
</BaseLayout>
