---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/chrome/Breadcrumbs.astro';
import LangText from '../../components/ui/LangText.astro';
import BlogPostCard from '../../components/content/BlogPostCard.astro';
import CTASection from '../../components/content/CTASection.astro';
import {
  blogIntro,
  blogPosts,
  blogSourceNote,
  blogTopicLabels,
  type BlogTopic,
} from '../../data/blog';
import {
  blogCadenceNote,
  getUpcomingSchedule,
  getTodayBlogAssignment,
  todayInVietnam,
} from '../../data/blogSchedule';
import { siteSeo } from '../../lib/seo';

const topics = Object.keys(blogTopicLabels) as BlogTopic[];
const siteOrigin = Astro.site ?? siteSeo.origin;
const today = todayInVietnam();
const todayAssignment = getTodayBlogAssignment();
const upcoming = getUpcomingSchedule(7);

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Cloudflare Starter Hub Blog',
  description: blogIntro.en,
  url: new URL('/blog/', siteOrigin).href,
  inLanguage: ['vi', 'en'],
  blogPost: blogPosts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title.en,
    datePublished: post.date,
    url: new URL(`/blog/${post.slug}/`, siteOrigin).href,
    description: post.description.en,
  })),
};
---

<BaseLayout
  title={{
    vi: 'Blog Cloudflare dễ hiểu — AI, Security, CDN, Workers',
    en: 'Plain-language Cloudflare blog — AI, Security, CDN, Workers',
  }}
  description={blogIntro}
  canonicalPath="/blog/"
  showProgressBar
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>

  <Breadcrumbs
    items={[{ href: '/blog/', label: { vi: 'Blog', en: 'Blog' } }]}
  />

  <header class="mb-8">
    <LangText as="h1" class="text-2xl font-semibold md:text-3xl" text={{ vi: 'Blog học Cloudflare', en: 'Cloudflare learning blog' }} />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-sm leading-relaxed md:text-base" text={blogIntro} />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-xs" text={blogSourceNote} />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-xs" text={blogCadenceNote} />
    <div class="mt-4 flex flex-wrap gap-2">
      <a class="btn btn-primary" href="https://blog.cloudflare.com/" target="_blank" rel="noopener noreferrer">
        <LangText text={{ vi: 'Nguồn: blog.cloudflare.com ↗', en: 'Source: blog.cloudflare.com ↗' }} />
      </a>
      <a class="btn btn-secondary" href="#schedule">
        <LangText text={{ vi: 'Lịch bài sắp tới', en: 'Upcoming schedule' }} />
      </a>
      <a class="btn btn-secondary" href="/tracks/">
        <LangText text={{ vi: 'Lộ trình học', en: 'Learning tracks' }} />
      </a>
      <a class="btn btn-secondary" href="/cloudflare-101/">
        <LangText text={{ vi: 'Cloudflare 101', en: 'Cloudflare 101' }} />
      </a>
    </div>
  </header>

  <section id="schedule" class="card mb-10" aria-labelledby="schedule-heading">
    <LangText
      as="h2"
      id="schedule-heading"
      class="text-lg font-semibold"
      text={{ vi: 'Lịch generate: 1 bài / ngày', en: 'Generate schedule: 1 post / day' }}
    />
    <LangText
      as="p"
      class="text-muted mt-2 text-sm"
      text={{
        vi: `Hôm nay (ICT): ${today}. Workflow GitHub mở issue generate lúc 00:05 giờ Việt Nam.`,
        en: `Today (ICT): ${today}. A GitHub Action opens the generate issue at 00:05 Vietnam time.`,
      }}
    />
    {
      todayAssignment.kind === 'planned' ? (
        <div class="mt-4 rounded-md border border-[var(--cf-border)] p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-[var(--cf-text-muted)]">
            <span class="lang-vi">Bài hôm nay · {todayAssignment.status}</span>
            <span class="lang-en">Today’s assignment · {todayAssignment.status}</span>
          </p>
          <LangText as="p" class="mt-2 font-semibold" text={todayAssignment.item.workingTitle} />
          <LangText as="p" class="text-muted mt-1 text-sm" text={todayAssignment.item.angle} />
          <p class="text-muted mt-2 text-xs">
            <LangText text={blogTopicLabels[todayAssignment.item.topic]} />
            <span aria-hidden="true"> · </span>
            {todayAssignment.item.date}
            <span aria-hidden="true"> · </span>
            <code>{todayAssignment.item.slug}</code>
          </p>
        </div>
      ) : todayAssignment.kind === 'published' ? (
        <div class="mt-4 rounded-md border border-[var(--cf-border)] p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-[var(--cf-text-muted)]">
            <span class="lang-vi">Đã xuất bản hôm nay</span>
            <span class="lang-en">Published today</span>
          </p>
          <p class="mt-2 font-semibold">
            <a class="link" href={`/blog/${todayAssignment.slug}/`}>
              <LangText text={todayAssignment.title} />
            </a>
          </p>
        </div>
      ) : (
        <LangText
          as="p"
          class="text-muted mt-4 text-sm"
          text={{
            vi: 'Chưa có mục lịch cho hôm nay — cần bổ sung blogScheduleQueue.',
            en: 'No schedule row for today — extend blogScheduleQueue.',
          }}
        />
      )
    }
    {
      upcoming.length > 0 ? (
        <div class="mt-6">
          <LangText
            as="h3"
            class="text-base font-semibold"
            text={{ vi: 'Sắp tới', en: 'Coming up' }}
          />
          <ul class="mt-3 space-y-3 text-sm">
            {upcoming.map((item) => (
              <li class="border-t border-[var(--cf-border)] pt-3">
                <p class="font-medium">
                  <time datetime={item.date}>{item.date}</time>
                  <span class="text-muted"> · </span>
                  <LangText text={blogTopicLabels[item.topic]} />
                  <span class="text-muted"> · </span>
                  <span class="badge">{item.level}</span>
                </p>
                <LangText as="p" class="mt-1" text={item.workingTitle} />
              </li>
            ))}
          </ul>
        </div>
      ) : null
    }
  </section>

  <nav class="card mb-8 flex flex-wrap gap-2 p-4 text-sm" aria-label="Blog topics">
    <span class="text-muted w-full text-xs font-medium uppercase tracking-wide">
      <span class="lang-vi">Chủ đề</span>
      <span class="lang-en">Topics</span>
    </span>
    {
      topics.map((topic) => (
        <a href={`#topic-${topic}`} class="badge hover:border-[var(--cf-accent)]">
          <LangText text={blogTopicLabels[topic]} />
        </a>
      ))
    }
  </nav>

  <section class="mb-10" aria-labelledby="all-posts">
    <LangText
      as="h2"
      id="all-posts"
      class="mb-4 text-lg font-semibold"
      text={{ vi: 'Tất cả bài (mới nhất trước)', en: 'All posts (newest first)' }}
    />
    <div class="grid gap-4 md:grid-cols-2">
      {blogPosts.map((post) => <BlogPostCard post={post} />)}
    </div>
  </section>

  {
    topics.map((topic) => {
      const posts = blogPosts.filter((p) => p.topic === topic);
      if (posts.length === 0) return null;
      return (
        <section class="mb-10" id={`topic-${topic}`} aria-labelledby={`heading-${topic}`}>
          <LangText
            as="h2"
            id={`heading-${topic}`}
            class="mb-4 text-lg font-semibold"
            text={blogTopicLabels[topic]}
          />
          <ul class="space-y-2 text-sm">
            {posts.map((post) => (
              <li>
                <a class="link font-medium" href={`/blog/${post.slug}/`}>
                  <LangText text={post.title} />
                </a>
                <span class="text-muted"> · {post.date}</span>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }

  <CTASection
    title={{
      vi: 'Muốn học theo lộ trình có cấu trúc?',
      en: 'Want a structured learning path?',
    }}
    description={{
      vi: 'Blog giúp bạn hiểu nhanh; tracks và use cases giúp bạn luyện theo từng bước.',
      en: 'The blog builds intuition; tracks and use cases help you practice step by step.',
    }}
    cta={{ href: '/start-here/', label: { vi: 'Bắt đầu tại đây', en: 'Start here' } }}
  />
</BaseLayout>
