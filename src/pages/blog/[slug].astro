---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/chrome/Breadcrumbs.astro';
import LangText from '../../components/ui/LangText.astro';
import CTASection from '../../components/content/CTASection.astro';
import BlogPostCard from '../../components/content/BlogPostCard.astro';
import BlogFigure from '../../components/content/BlogFigure.astro';
import ReferenceDiagramFigure from '../../components/content/ReferenceDiagramFigure.astro';
import {
  blogLevelLabels,
  blogPosts,
  blogSourceNote,
  blogTopicLabels,
  countBlogWords,
  getBlogPost,
  getRelatedBlogPosts,
} from '../../data/blog';
import { getDiagramBySlug } from '../../data/referenceDiagrams';
import { getProductBySlug } from '../../data/productPages';
import { tracks } from '../../data/tracks';
import { siteSeo } from '../../lib/seo';

export function getStaticPaths() {
  return blogPosts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!);
if (!post) throw new Error(`Blog post not found: ${slug}`);

const related = getRelatedBlogPosts(post, 3);
const hubHrefs = new Set(post.hubLinks.map((l) => l.href.replace(/\/$/, '')));
const track = tracks.find((t) => t.slug === post.relatedTrack);
const trackHref = track ? `/tracks/${track.slug}` : null;
const showTrackLink = Boolean(trackHref && !hubHrefs.has(trackHref));
const products = (post.relatedProductSlugs ?? [])
  .map((s) => getProductBySlug(s))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .filter((p) => !hubHrefs.has(`/products/${p.slug}`));

const diagrams = (post.diagramSlugs ?? [])
  .map((s) => getDiagramBySlug(s))
  .filter((d): d is NonNullable<typeof d> => Boolean(d && d.primaryImageUrl));
const heroDiagram = diagrams[0];
const sectionDiagramSlugs = new Set(
  post.sections.map((s) => s.diagramSlug).filter((s): s is string => Boolean(s)),
);
/** Extra official diagrams not already embedded mid-article via sections[].diagramSlug */
const galleryDiagrams = diagrams
  .slice(1)
  .filter((d) => !sectionDiagramSlugs.has(d.slug));
const customImages = post.images ?? [];
const ogImage = customImages[0]?.src ?? heroDiagram?.primaryImageUrl;

const siteOrigin = Astro.site ?? siteSeo.origin;
const canonicalUrl = new URL(`/blog/${post.slug}/`, siteOrigin).href;
const wordsVi = countBlogWords(post, 'vi');
const wordsEn = countBlogWords(post, 'en');
const jsonLdImage = ogImage ? new URL(ogImage, siteOrigin).href : undefined;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title.en,
  alternativeHeadline: post.title.vi,
  description: post.description.en,
  datePublished: post.date,
  dateModified: post.updated ?? post.date,
  inLanguage: ['vi', 'en'],
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
  keywords: `${post.keywords.en}, ${post.keywords.vi}`,
  ...(jsonLdImage ? { image: [jsonLdImage] } : {}),
  author: {
    '@type': 'Organization',
    name: siteSeo.name,
    url: siteOrigin,
  },
  publisher: {
    '@type': 'Organization',
    name: siteSeo.name,
    url: siteOrigin,
  },
  isBasedOn: post.sources.map((s) => s.href),
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.blog-answer-summary', '.blog-faq'],
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faq.map((item) => ({
    '@type': 'Question',
    name: item.question.en,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.en,
    },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Blog',
      item: new URL('/blog/', siteOrigin).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: post.title.en,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  canonicalPath={`/blog/${post.slug}/`}
  showProgressBar
  ogType="article"
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content={`${post.keywords.vi}, ${post.keywords.en}`} />
    <meta property="article:published_time" content={post.date} />
    {post.updated ? <meta property="article:modified_time" content={post.updated} /> : null}
    <meta property="article:section" content={blogTopicLabels[post.topic].en} />
    <link rel="alternate" hrefLang="vi" href={canonicalUrl} />
    <link rel="alternate" hrefLang="en" href={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <Breadcrumbs
    items={[
      { href: '/blog/', label: { vi: 'Blog', en: 'Blog' } },
      { href: `/blog/${post.slug}/`, label: post.title },
    ]}
  />

  <article>
    <header class="mb-8">
      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
        <span class="badge"><LangText text={blogTopicLabels[post.topic]} /></span>
        <span class="badge"><LangText text={blogLevelLabels[post.level]} /></span>
        <time class="text-muted" datetime={post.date}>{post.date}</time>
        <span class="text-muted">
          <span class="lang-vi">~{post.readingMinutes} phút đọc · ~{wordsVi} từ</span>
          <span class="lang-en">~{post.readingMinutes} min read · ~{wordsEn} words</span>
        </span>
      </div>
      <LangText as="h1" class="text-2xl font-semibold md:text-3xl" text={post.title} />
      <LangText
        as="p"
        class="blog-answer-summary text-muted mt-3 max-w-3xl text-sm leading-relaxed md:text-base"
        text={post.excerpt}
      />
    </header>

    {
      heroDiagram ? (
        <div class="mb-8">
          <ReferenceDiagramFigure diagram={heroDiagram} />
        </div>
      ) : null
    }
    {
      customImages[0] ? (
        <div class="mb-8">
          <BlogFigure image={customImages[0]} eager={!heroDiagram} />
        </div>
      ) : null
    }

    <div class="mx-auto max-w-3xl space-y-8">
      {
        post.sections.map((section) => {
          const sectionDiagram = section.diagramSlug ? getDiagramBySlug(section.diagramSlug) : undefined;
          return (
            <section>
              <LangText as="h2" class="text-xl font-semibold" text={section.heading} />
              {section.paragraphs.map((paragraph) => (
                <LangText as="p" class="text-muted mt-3 text-sm leading-relaxed md:text-base" text={paragraph} />
              ))}
              {sectionDiagram ? (
                <div class="mt-5">
                  <ReferenceDiagramFigure diagram={sectionDiagram} compact />
                </div>
              ) : null}
              {section.image ? (
                <div class="mt-5">
                  <BlogFigure image={section.image} />
                </div>
              ) : null}
            </section>
          );
        })
      }

      {
        galleryDiagrams.length > 0 || customImages.length > 1 ? (
          <section aria-labelledby="visuals-heading">
            <LangText
              as="h2"
              id="visuals-heading"
              class="text-xl font-semibold"
              text={{ vi: 'Hình minh họa Cloudflare', en: 'Cloudflare visuals' }}
            />
            <LangText
              as="p"
              class="text-muted mt-2 text-sm"
              text={{
                vi: 'Sơ đồ Reference Architecture chính thức và (khi có) ảnh Dashboard — giúp đối chiếu khi học.',
                en: 'Official Reference Architecture diagrams and (when available) Dashboard screenshots — useful while you learn.',
              }}
            />
            <div class="mt-4 space-y-6">
              {galleryDiagrams.map((d) => (
                <ReferenceDiagramFigure diagram={d} compact />
              ))}
              {customImages.slice(1).map((img) => (
                <BlogFigure image={img} />
              ))}
            </div>
          </section>
        ) : null
      }

      <section class="blog-faq" aria-labelledby="faq-heading">
        <LangText
          as="h2"
          id="faq-heading"
          class="text-xl font-semibold"
          text={{ vi: 'Câu hỏi thường gặp', en: 'Frequently asked questions' }}
        />
        <div class="mt-4 space-y-4">
          {
            post.faq.map((item) => (
              <div class="border-t border-[var(--cf-border)] pt-4">
                <LangText as="h3" class="text-base font-semibold" text={item.question} />
                <LangText as="p" class="text-muted mt-2 text-sm leading-relaxed" text={item.answer} />
              </div>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="learn-more-heading">
        <LangText
          as="h2"
          id="learn-more-heading"
          class="text-xl font-semibold"
          text={{ vi: 'Học tiếp trên hub (on-page backlinks)', en: 'Keep learning on this hub (on-page links)' }}
        />
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">
          {
            post.hubLinks.map((link) => (
              <li>
                <a class="link" href={link.href}>
                  <LangText text={link.label} />
                </a>
              </li>
            ))
          }
          {
            showTrackLink && track ? (
              <li>
                <a class="link" href={`/tracks/${track.slug}/`}>
                  <LangText
                    text={{
                      vi: `Lộ trình liên quan: ${track.title.vi}`,
                      en: `Related track: ${track.title.en}`,
                    }}
                  />
                </a>
              </li>
            ) : null
          }
          {
            products.map((product) => (
              <li>
                <a class="link" href={`/products/${product.slug}/`}>
                  <LangText
                    text={{
                      vi: `Sản phẩm: ${product.name.vi}`,
                      en: `Product: ${product.name.en}`,
                    }}
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="sources-heading">
        <LangText
          as="h2"
          id="sources-heading"
          class="text-xl font-semibold"
          text={{ vi: 'Nguồn tham khảo (blog.cloudflare.com)', en: 'Sources (blog.cloudflare.com)' }}
        />
        <LangText as="p" class="text-muted mt-2 text-xs" text={blogSourceNote} />
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">
          {
            post.sources.map((source) => (
              <li>
                <a class="link" href={source.href} target="_blank" rel="noopener noreferrer">
                  {source.title} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </article>

  <section class="mt-12" aria-labelledby="related-posts">
    <LangText
      as="h2"
      id="related-posts"
      class="mb-4 text-lg font-semibold"
      text={{ vi: 'Bài liên quan trong blog', en: 'Related posts in this blog' }}
    />
    <div class="grid gap-4 md:grid-cols-3">
      {related.map((p) => <BlogPostCard post={p} />)}
    </div>
  </section>

  <CTASection
    title={{
      vi: 'Xem tất cả bài blog',
      en: 'Browse all blog posts',
    }}
    description={{
      vi: 'Chuỗi bài AI · Security · CDN · Workers · Developer Platform — viết lại cho người mới và trung cấp.',
      en: 'AI · Security · CDN · Workers · Developer Platform — rewritten for entry and intermediate learners.',
    }}
    cta={{ href: '/blog/', label: { vi: 'Về trang Blog', en: 'Back to Blog' } }}
  />
</BaseLayout>
