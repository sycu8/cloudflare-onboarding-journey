---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/chrome/Breadcrumbs.astro';
import LangText from '../components/ui/LangText.astro';
import StatusDashboard from '../components/interactive/StatusDashboard';
import {
  statusIntro,
  statusSourceNote,
  CLOUDFLARE_STATUS_URL,
  CLOUDFLARE_STATUS_HISTORY_URL,
  CLOUDFLARE_STATUS_RSS_URL,
} from '../data/systemStatus';
---

<BaseLayout
  title={{ vi: 'Trạng thái hệ thống Cloudflare', en: 'Cloudflare system status', km: 'Cloudflare system status' }}
  description={{
    vi: 'Sự cố Cloudflare chỉ từ www.cloudflarestatus.com: đang mở trên trang chính, đã qua trên trang lịch sử.',
    en: 'Cloudflare incidents only from www.cloudflarestatus.com: open items from the overview, past items from history.',
  }}
  canonicalPath="/status"
  showProgressBar
>
  <Breadcrumbs
    items={[
      { href: '/resources', label: { vi: 'Tài nguyên', en: 'Resources', km: 'Resources' } },
      { href: '/status', label: { vi: 'System status', en: 'System status', km: 'System status' } },
    ]}
  />

  <header class="mb-8">
    <LangText as="h1" class="text-2xl font-semibold md:text-3xl" text={{ vi: 'Trạng thái hệ thống & sự cố', en: 'System status & incidents', km: 'System status & incidents' }} />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-sm md:text-base" text={statusIntro} />
    <LangText as="p" class="text-muted mt-2 text-xs" text={statusSourceNote} />
    <div class="mt-4 flex flex-wrap gap-2">
      <a class="btn btn-primary" href={CLOUDFLARE_STATUS_URL} target="_blank" rel="noopener noreferrer">
        www.cloudflarestatus.com ↗
      </a>
      <a class="btn btn-secondary" href={CLOUDFLARE_STATUS_HISTORY_URL} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">Lịch sử sự cố ↗</span>
        <span class="lang-en">Incident history ↗</span>
        <span class="lang-km">Incident history ↗</span>
      </a>
      <a class="btn btn-secondary" href={CLOUDFLARE_STATUS_RSS_URL} target="_blank" rel="noopener noreferrer">
        RSS ↗
      </a>
    </div>
  </header>

  <section id="live-status">
    <StatusDashboard client:load />
  </section>
</BaseLayout>
