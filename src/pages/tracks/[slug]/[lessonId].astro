---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/chrome/Breadcrumbs.astro';
import LangText from '../../../components/ui/LangText.astro';
import ReferenceDiagramFigure from '../../../components/content/ReferenceDiagramFigure.astro';
import CloudflareResourceCard from '../../../components/content/CloudflareResourceCard.astro';
import LessonKindBadge from '../../../components/content/LessonKindBadge.astro';
import KnowledgeLesson from '../../../components/content/KnowledgeLesson.astro';
import FlowNav from '../../../components/content/FlowNav.astro';
import {
  getAllFlatTrackLessons,
  getFlatTrackLesson,
  getLessonEnrichment,
  getLessonDiagrams,
  getLessonHeroImage,
} from '../../../data/trackLessons';
import { estimateBadge, getFlowNeighbors, getTrackFlow, labsAfterLesson } from '../../../data/trackFlow';
import { trackIndexMeta } from '../../../data/trackCatalog';
import { inferLessonKind } from '../../../data/lessonKind';
import { getOnboardingPageForLesson, onboardingHtml } from '../../../data/zeroTrustOnboarding';
import OnboardingArticle from '../../../components/content/OnboardingArticle.astro';
import FollowAlongArticle from '../../../components/content/FollowAlongArticle.astro';
import { getFollowAlongLesson } from '../../../data/followAlongLessons';
import { getDeploymentExamplesForLesson } from '../../../data/cloudflareResources';
import { getProductBySlug } from '../../../data/productPages';
import { tracks } from '../../../data/tracks';
import TrackContextBanner from '../../../components/content/TrackContextBanner.astro';
import TrackSwitcher from '../../../components/content/TrackSwitcher.astro';
import TrackToc from '../../../components/interactive/TrackToc';
import TrackLessonDone from '../../../components/interactive/TrackLessonDone';

export function getStaticPaths() {
  return getAllFlatTrackLessons().map((l) => ({
    params: { slug: l.trackSlug, lessonId: l.id },
  }));
}

const { slug, lessonId } = Astro.params;
const lesson = getFlatTrackLesson(slug!, lessonId!);
if (!lesson) throw new Error(`Lesson not found: ${slug}/${lessonId}`);

const track = tracks.find((t) => t.slug === slug)!;
const enrichment = getLessonEnrichment(lesson);
const diagrams = getLessonDiagrams(lesson);
const heroImage = getLessonHeroImage(lesson);
const neighbors = getFlowNeighbors(track.slug, lesson.id);
const kind = neighbors.current?.kind ?? inferLessonKind(lesson.moduleId, lesson.kind);
const duration = neighbors.current?.duration;
const prereqs = (neighbors.current?.prerequisiteIds ?? [])
  .map((id) => neighbors.flow.find((item) => item.key === id))
  .filter((item): item is NonNullable<typeof item> => !!item);
const labLinks = kind === 'knowledge' ? labsAfterLesson(track.slug, lesson.id) : [];
const relatedProducts = (enrichment.productSlugs ?? [])
  .map((s) => getProductBySlug(s))
  .filter((p): p is NonNullable<ReturnType<typeof getProductBySlug>> => !!p);
const deploymentExamples = getDeploymentExamplesForLesson(lesson.id);
const onboardingPage = track.slug === 'cloudflare-one' ? getOnboardingPageForLesson(lesson.id) : undefined;
const followAlong = !onboardingPage ? getFollowAlongLesson(lesson.id) : undefined;
const flow = getTrackFlow(track.slug);
const tocItems = flow.map((item) => ({
  key: item.key,
  kind: item.kind,
  href: item.href,
  title: item.title,
  moduleId: item.moduleId,
  moduleTitle: item.moduleTitle,
  duration: item.duration ?? null,
  minutes: item.minutes,
}));
---

<BaseLayout
  title={{
    vi: `${lesson.title.vi} · ${track.title.vi}`,
    en: `${lesson.title.en} · ${track.title.en}`,
  }}
  description={lesson.body}
  canonicalPath={`/tracks/${track.slug}/${lesson.id}`}
  showProgressBar
>
  <Breadcrumbs
    items={[
      { href: `/tracks/${track.slug}`, label: track.title },
      { href: `/tracks/${track.slug}/${lesson.id}`, label: lesson.title },
    ]}
  />

  <TrackContextBanner track={track} />

  <div class="track-layout">
    <TrackToc client:load trackSlug={track.slug} items={tocItems} currentKey={lesson.id} />
    <div class="min-w-0">

  <header class="mb-6">
    <p class="text-muted mb-2 text-xs font-medium uppercase tracking-wide">
      <LangText text={lesson.moduleTitle} />
      <span class="opacity-60">
        ·
        <span class="lang-vi"> Bài {lesson.lessonIndex + 1}/{lesson.totalLessonsInModule}</span>
        <span class="lang-en"> Lesson {lesson.lessonIndex + 1}/{lesson.totalLessonsInModule}</span>
        <span class="lang-km"> Lesson {lesson.lessonIndex + 1}/{lesson.totalLessonsInModule}</span>
      </span>
    </p>
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <LessonKindBadge kind={kind} />
      {duration ? (
        <span class="badge">
          <LangText text={estimateBadge(duration)} />
        </span>
      ) : null}
      <TrackLessonDone client:load itemKey={lesson.id} />
    </div>
    <LangText as="h1" class="text-2xl font-semibold md:text-3xl" text={lesson.title} />
    {prereqs.length > 0 ? (
      <p class="text-muted mt-3 text-sm leading-relaxed">
        <span class="lang-vi">Nên đọc trước: </span>
        <span class="lang-en">Read first: </span>
        <span class="lang-km">Read first: </span>
        {prereqs.map((item, index) => (
          <>
            {index > 0 ? <span>, </span> : null}
            <a class="link" href={item.href}>
              <LangText text={item.title} />
            </a>
          </>
        ))}
      </p>
    ) : neighbors.current?.isTrackStart ? (
      <p class="text-muted mt-3 text-sm leading-relaxed">
        <span class="lang-vi">Không cần bài trước. </span>
        <span class="lang-en">No prerequisites. </span>
        <span class="lang-km">No prerequisites. </span>
        <LangText text={trackIndexMeta[track.slug].prereq} />
      </p>
    ) : null}
  </header>

  {kind === 'knowledge' ? (
    <KnowledgeLesson
      lesson={lesson}
      enrichment={enrichment}
      diagrams={diagrams}
      followAlong={followAlong}
      onboardingHtml={onboardingPage ? onboardingHtml(onboardingPage) : undefined}
      onboardingSourceUrl={onboardingPage?.sourceUrl}
      heroImage={heroImage}
      labLinks={labLinks}
    />
  ) : onboardingPage ? (
    <OnboardingArticle html={onboardingHtml(onboardingPage)} sourceUrl={onboardingPage.sourceUrl} />
  ) : followAlong ? (
    <FollowAlongArticle lesson={followAlong} />
  ) : (
    <>
      {heroImage ? (
        <figure class="card mb-8 overflow-hidden p-0">
          <img
            src={heroImage}
            alt={lesson.title.en}
            loading="eager"
            decoding="async"
            class="max-h-[20rem] w-full bg-[var(--cf-bg-elevated)] object-contain p-4"
          />
          <figcaption class="text-muted border-t border-[var(--cf-border)] px-4 py-2 text-xs">
            <span class="lang-vi">Minh họa từ sơ đồ kiến trúc tham chiếu Cloudflare (developers.cloudflare.com)</span>
            <span class="lang-en">Illustration from Cloudflare Reference Architecture (developers.cloudflare.com)</span>
            <span class="lang-km">Illustration from Cloudflare Reference Architecture (developers.cloudflare.com)</span>
          </figcaption>
        </figure>
      ) : null}

      <section class="card mb-6">
        <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'Các bước thực hiện', en: 'Step-by-step', km: 'Step-by-step' }} />
        <ol class="text-muted mt-4 list-decimal space-y-3 pl-5 text-sm leading-relaxed">
          {enrichment.steps.vi.map((step, i) => (
            <li>
              <span class="lang-vi">{step}</span>
              <span class="lang-en">{enrichment.steps.en[i]}</span>
              <span class="lang-km">{enrichment.steps.en[i]}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="card mb-6">
        <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'Giải thích chi tiết', en: 'Detailed explanation', km: 'Detailed explanation' }} />
        <LangText as="p" class="text-muted mt-3 text-sm leading-relaxed" text={enrichment.deepDive} />
        {lesson.tip ? (
          <p class="mt-4 rounded-lg border border-[var(--cf-border)] bg-[var(--cf-surface)] px-4 py-3 text-sm">
            <span class="font-medium text-[var(--cf-accent)]">
              <span class="lang-vi">Mẹo: </span>
              <span class="lang-en">Tip: </span>
              <span class="lang-km">Tip: </span>
            </span>
            <LangText text={lesson.tip} />
          </p>
        ) : null}
      </section>
    </>
  )}

  {enrichment.bestPracticeNote ? (
    <section class="card mb-6 border-l-4 border-[var(--cf-accent)]">
      <LangText
        as="h2"
        class="text-lg font-semibold"
        text={{ vi: 'Lưu ý (best practices)', en: 'Note (best practices)', km: 'Note (best practices)' }}
      />
      <LangText as="p" class="text-muted mt-3 text-sm leading-relaxed" text={enrichment.bestPracticeNote.text} />
      <p class="text-muted mt-3 text-xs">
        <span class="lang-vi">Nguồn: </span>
        <span class="lang-en">Source: </span>
        <span class="lang-km">Source: </span>
        <a
          class="link"
          href={enrichment.bestPracticeNote.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <LangText text={enrichment.bestPracticeNote.sourceTitle} /> ↗
        </a>
      </p>
    </section>
  ) : null}

  {deploymentExamples.length > 0 ? (
    <section class="card mb-6">
      <LangText
        as="h2"
        class="text-lg font-semibold"
        text={{ vi: 'Ví dụ triển khai (Cloudflare Resources)', en: 'Deployment examples (Cloudflare Resources)', km: 'Deployment examples (Cloudflare Resources)' }}
      />
      <p class="text-muted mt-2 text-xs">
        <span class="lang-vi">Ví dụ chính thức từ Cloudflare Resources — gợi ý theo chủ đề bài học trong lộ trình này.</span>
        <span class="lang-en">Official examples from Cloudflare Resources — matched to this lesson within this path.</span>
        <span class="lang-km">Official examples from Cloudflare Resources — matched to this lesson within this path.</span>
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {deploymentExamples.map((resource) => (
          <CloudflareResourceCard resource={resource} compact />
        ))}
      </div>
      <p class="text-muted mt-4 text-xs">
        <a class="link" href={`/tracks/${track.slug}/#track-resources`}>
          <LangText text={{ vi: 'Xem thêm ví dụ trong lộ trình →', en: 'More examples in this path →', km: 'More examples in this path →' }} />
        </a>
      </p>
    </section>
  ) : null}

  {enrichment.docsLinks.length > 0 ? (
    <section class="card mb-6">
      <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'Tài liệu Cloudflare Developers', en: 'Cloudflare Developer docs', km: 'Cloudflare Developer docs' }} />
      <ul class="mt-3 space-y-2 text-sm">
        {enrichment.docsLinks.map((link) => (
          <li>
            <a class="link" href={link.url} target="_blank" rel="noopener noreferrer">
              <LangText text={link.label} /> ↗
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : null}

  {enrichment.apiLinks && enrichment.apiLinks.length > 0 ? (
    <section class="card mb-6">
      <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'Cloudflare API (tham khảo)', en: 'Cloudflare API (reference)', km: 'Cloudflare API (reference)' }} />
      <p class="text-muted mt-2 text-xs">
        <span class="lang-vi">Dùng khi tự động hóa bước này qua script hoặc Terraform — cần API token phù hợp.</span>
        <span class="lang-en">Use when automating this step via script or Terraform — requires an appropriate API token.</span>
        <span class="lang-km">Use when automating this step via script or Terraform — requires an appropriate API token.</span>
      </p>
      <ul class="mt-3 space-y-2 text-sm">
        {enrichment.apiLinks.map((link) => (
          <li class="flex flex-wrap items-center gap-2">
            {link.method ? <span class="badge font-mono text-xs">{link.method}</span> : null}
            <a class="link break-all" href={link.url} target="_blank" rel="noopener noreferrer">
              <LangText text={link.label} /> ↗
            </a>
          </li>
        ))}
      </ul>
      <p class="text-muted mt-3 text-xs">
        <a class="link" href="https://developers.cloudflare.com/api/" target="_blank" rel="noopener noreferrer">
          developers.cloudflare.com/api ↗
        </a>
      </p>
    </section>
  ) : null}

  {kind !== 'knowledge' && diagrams.length > 0 ? (
    <section class="mb-6">
      <LangText
        as="h2"
        class="mb-4 text-lg font-semibold"
        text={{ vi: 'Sơ đồ kiến trúc tham chiếu (Cloudflare Docs)', en: 'Architecture diagrams (Cloudflare Docs)', km: 'Architecture diagrams (Cloudflare Docs)' }}
      />
      <div class="grid gap-6 lg:grid-cols-2">
        {diagrams.map((d) => (
          <ReferenceDiagramFigure diagram={d} />
        ))}
      </div>
    </section>
  ) : null}

  {relatedProducts.length > 0 ? (
    <section class="card mb-6">
      <LangText as="h2" class="text-lg font-semibold" text={{ vi: 'Sản phẩm liên quan', en: 'Related products', km: 'Related products' }} />
      <ul class="mt-3 flex flex-wrap gap-2">
        {relatedProducts.map((p) => (
          <li>
            <a class="badge badge-accent hover:opacity-90" href={`/products/${p.slug}`}>
              <LangText text={p.name} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : null}

  <FlowNav
    prev={neighbors.prev}
    next={neighbors.next}
    trackHref={`/tracks/${track.slug}`}
    doneCta={track.cta}
  />

  <TrackSwitcher current={track} />
    </div>
  </div>
</BaseLayout>
