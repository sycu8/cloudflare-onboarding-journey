---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/chrome/Breadcrumbs.astro';
import LangText from '../../components/ui/LangText.astro';
import { tracks, type Track } from '../../data/tracks';
import { courseJsonLd, siteSeo } from '../../lib/seo';
import {
  TRACK_DISPLAY_ORDER,
  foundationStep,
  trackIndexMeta,
} from '../../data/trackCatalog';
import { getTrackFlow, sumFlowMinutes } from '../../data/trackFlow';

const ordered = TRACK_DISPLAY_ORDER.map((slug) => tracks.find((track) => track.slug === slug)).filter(
  (track): track is Track => !!track,
);

const courseLd = courseJsonLd(
  Astro.site ?? siteSeo.origin,
  '/tracks',
  { vi: 'Lộ trình học Cloudflare', en: 'Cloudflare learning tracks' },
  {
    vi: 'Năm lộ trình miễn phí: Application Services, Developer Platform, Cloudflare One, AI Security & Adoption và Operational Excellence.',
    en: 'Five free tracks: Application Services, Developer Platform, Cloudflare One, AI Security & Adoption, and Operational Excellence.',
  },
);
---

<BaseLayout
  title={{ vi: 'Lộ trình học Cloudflare', en: 'Cloudflare learning tracks', km: 'Cloudflare learning tracks' }}
  description={{
    vi: 'Năm lộ trình: Application Services, Developer Platform, Cloudflare One, AI Security & Adoption và Operational Excellence. Bước 0 là nền tảng.',
    en: 'Five tracks: Application Services, Developer Platform, Cloudflare One, AI Security & Adoption, and Operational Excellence. Step 0 is the foundation.',
  }}
  canonicalPath="/tracks"
  showProgressBar
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(courseLd)} />
  </Fragment>

  <Breadcrumbs items={[{ href: '/tracks', label: { vi: 'Lộ trình học', en: 'Tracks' , km: 'Tracks' } }]} />

  <header class="mb-8">
    <LangText as="h1" class="text-2xl font-semibold md:text-3xl" text={{ vi: 'Lộ trình học', en: 'Learning tracks', km: 'Learning tracks' }} />
    <LangText
      as="p"
      class="text-muted mt-2 max-w-3xl text-sm leading-relaxed"
      text={{
        vi: 'Bước 0 là nền tảng. Sau đó học tuần tự trong một lộ trình: kiến thức trước, lab sau. Mỗi lộ trình học độc lập. Phần điều kiện chỉ là gợi ý.',
        en: 'Step 0 is the foundation. Then learn in order inside one track: knowledge first, labs after. Each track stands on its own. The prerequisite line is only a suggestion.',
      }}
    />
  </header>

  <section class="card mb-6" id="step-0">
    <div class="flex flex-wrap items-center gap-2">
      <span class="badge badge-accent">
        <span class="lang-vi">Bước 0</span>
        <span class="lang-en">Step 0</span>
        <span class="lang-km">Step 0</span>
      </span>
    </div>
    <LangText as="h2" class="mt-3 text-lg font-semibold" text={foundationStep.title} />
    <LangText as="p" class="text-muted mt-2 text-sm leading-relaxed" text={foundationStep.summary} />
    <ul class="mt-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
      {foundationStep.links.map((link) => (
        <li>
          <a class="btn btn-secondary" href={link.href}>
            <LangText text={link.label} />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <ol class="space-y-4">
    {ordered.map((track, index) => {
      const meta = trackIndexMeta[track.slug];
      const flow = getTrackFlow(track.slug);
      const knowledge = flow.filter((item) => item.kind === 'knowledge').length;
      const reference = flow.filter((item) => item.kind === 'reference').length;
      const hubLabs = flow.filter((item) => item.kind === 'lab-hub').length;
      const officialLabs = flow.filter((item) => item.kind === 'lab-official').length;
      const minutes = sumFlowMinutes(flow);
      return (
        <li class="card">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge">
              <span class="lang-vi">Bước {index + 1}</span>
              <span class="lang-en">Step {index + 1}</span>
              <span class="lang-km">Step {index + 1}</span>
            </span>
            <span class="badge">
              <LangText text={meta.level} />
            </span>
            {meta.suggestedStart ? (
              <span class="badge badge-accent">
                <span class="lang-vi">Nên bắt đầu từ đây</span>
                <span class="lang-en">Begin here</span>
                <span class="lang-km">Begin here</span>
              </span>
            ) : null}
          </div>
          <LangText as="h2" class="mt-3 text-lg font-semibold" text={track.title} />
          <LangText as="p" class="text-muted mt-2 text-sm leading-relaxed" text={track.headline} />
          <p class="text-muted mt-3 text-xs leading-relaxed">
            <span class="lang-vi">
              {track.modules.length} phần · {knowledge} bài kiến thức
              {reference > 0 ? ` · ${reference} bài tham chiếu` : ''}
              {hubLabs > 0 ? ` · ${hubLabs} lab (hub)` : ''}
              {officialLabs > 0 ? ` · ${officialLabs} lab (Cloudflare)` : ''}
              {minutes ? ` · ~${minutes} phút (tổng ước lượng các phần)` : ''}
            </span>
            <span class="lang-en">
              {track.modules.length} parts · {knowledge} knowledge
              {reference > 0 ? ` · ${reference} reference` : ''}
              {hubLabs > 0 ? ` · ${hubLabs} hub labs` : ''}
              {officialLabs > 0 ? ` · ${officialLabs} Cloudflare labs` : ''}
              {minutes ? ` · ~${minutes} min (estimated total)` : ''}
            </span>
            <span class="lang-km">
              {track.modules.length} parts · {knowledge} knowledge
              {reference > 0 ? ` · ${reference} reference` : ''}
              {hubLabs > 0 ? ` · ${hubLabs} hub labs` : ''}
              {officialLabs > 0 ? ` · ${officialLabs} Cloudflare labs` : ''}
              {minutes ? ` · ~${minutes} min (estimated total)` : ''}
            </span>
          </p>
          <p class="text-muted mt-1 text-xs">
            <span class="lang-vi">Điều kiện gợi ý: </span>
            <span class="lang-en">Suggested prerequisite: </span>
            <span class="lang-km">Suggested prerequisite: </span>
            <LangText text={meta.prereq} />
          </p>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {track.keyConcepts.slice(0, 4).map((concept) => (
              <li class="badge text-xs">{concept}</li>
            ))}
          </ul>
          <a class="btn btn-primary mt-4" href={`/tracks/${track.slug}`}>
            <LangText text={{ vi: 'Vào lộ trình này', en: 'Enter this path', km: 'Enter this path' }} />
          </a>
        </li>
      );
    })}
  </ol>

  <p class="text-muted mt-8 text-center text-sm">
    <LangText
      text={{
        vi: 'Chưa chắc chọn hướng nào?',
        en: 'Not sure which direction?',
      }}
    />
    {' '}
    <a class="link" href="/choose-your-path">
      <LangText text={{ vi: 'Làm bài chọn lộ trình', en: 'Use the path selector', km: 'Use the path selector' }} />
    </a>
  </p>
</BaseLayout>
