---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/chrome/Breadcrumbs.astro';
import LangText from '../../components/ui/LangText.astro';
import TutorialGuide from '../../components/content/TutorialGuide.astro';
import { cloudflareResources } from '../../data/cloudflareResources';
import {
  cloudflareResourceContentTypeLabels,
  cloudflareResourceTrackLabels,
} from '../../data/cloudflareResources';
import {
  getAllTutorialPreviews,
  getTutorialDisplayTitle,
  getTutorialPreviewByPath,
} from '../../data/tutorialPreviews';
import { tutorialChrome } from '../../data/tutorialCopy';

export function getStaticPaths() {
  const fromPreviews = getAllTutorialPreviews().map((p) => ({
    params: { path: p.path.replace(/^\//, '').replace(/\/$/, '') },
  }));

  const seen = new Set(fromPreviews.map((x) => x.params.path));
  for (const r of cloudflareResources) {
    if (r.contentType !== 'Tutorial' && r.contentType !== 'Solution guide') continue;
    const path = r.path.replace(/^\//, '').replace(/\/$/, '');
    if (!seen.has(path)) {
      fromPreviews.push({ params: { path } });
      seen.add(path);
    }
  }

  return fromPreviews;
}

const pathParam = Astro.params.path ?? '';
const docPath = `/${pathParam.replace(/\/$/, '')}`;
const preview = getTutorialPreviewByPath(docPath);
const resource = cloudflareResources.find((r) => r.path.replace(/\/$/, '') === docPath.replace(/\/$/, ''));

const titleEn = preview?.title ?? resource?.title ?? pathParam;
const titleVi = preview ? getTutorialDisplayTitle(preview, 'vi') : titleEn;
const titleKm = preview ? getTutorialDisplayTitle(preview, 'km') : titleEn;
const officialUrl = preview?.url ?? resource?.url ?? `https://developers.cloudflare.com${docPath}/`;
const contentType = preview?.contentType ?? resource?.contentType ?? 'Tutorial';
const track = preview?.track ?? resource?.track ?? 'cross-cutting';
const typeLabel = cloudflareResourceContentTypeLabels[contentType as keyof typeof cloudflareResourceContentTypeLabels];
const trackLabel = cloudflareResourceTrackLabels[track as keyof typeof cloudflareResourceTrackLabels];

const pageTitle = { vi: titleVi, en: titleEn, km: titleKm };
function safeSeoDescription(value: string | undefined, fallback: string): string {
  if (!value || /<\s*(?:!doctype|html|head|body|script|img|h[1-6])\b/i.test(value)) return fallback;
  return value.replace(/\s+/g, ' ').trim().slice(0, 320);
}
const pageDesc = {
  vi: safeSeoDescription(preview?.summaryVi, `Hướng dẫn tutorial Cloudflare trên hub — có backlink tới docs gốc.`),
  en: safeSeoDescription(preview?.summaryEn, `Cloudflare tutorial guide on the hub with links to official docs.`),
  km: safeSeoDescription(
    preview?.summaryKm ?? preview?.summaryEn,
    `មគ្គុទ្ទេសក៍ tutorial Cloudflare នៅលើ hub — មានតំណទៅ docs ផ្លូវការ។`,
  ),
};

const hasGuide = Boolean(preview?.sections && preview.sections.length > 0);
---

<BaseLayout title={pageTitle} description={pageDesc} canonicalPath={`/tutorials/${pathParam}/`}>
  <Breadcrumbs
    items={[
      { href: '/resources', label: tutorialChrome.resources },
      { href: '/resources#cloudflare-resources', label: { vi: 'Cloudflare Resources', en: 'Cloudflare Resources', km: 'Cloudflare Resources' } },
      { href: `/tutorials/${pathParam}/`, label: { vi: titleVi, en: titleEn, km: titleKm } },
    ]}
  />

  <article class="mx-auto max-w-5xl">
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-2">
        {typeLabel ? (
          <span class="badge badge-accent text-xs"><LangText text={typeLabel} /></span>
        ) : null}
        {trackLabel ? <span class="badge text-xs"><LangText text={trackLabel} /></span> : null}
        {preview?.estimatedMinutes ? (
          <span class="badge text-xs">
            <span class="lang-vi">~{preview.estimatedMinutes} {tutorialChrome.minutes.vi}</span>
            <span class="lang-en">~{preview.estimatedMinutes} {tutorialChrome.minutes.en}</span>
            <span class="lang-km">~{preview.estimatedMinutes} {tutorialChrome.minutes.km}</span>
          </span>
        ) : null}
        {preview?.crawledAt ? (
          <span class="text-muted text-xs">
            <span class="lang-vi">{tutorialChrome.synced.vi} {preview.crawledAt}</span>
            <span class="lang-en">{tutorialChrome.synced.en} {preview.crawledAt}</span>
            <span class="lang-km">{tutorialChrome.synced.km} {preview.crawledAt}</span>
          </span>
        ) : null}
      </div>

      <h1 class="mt-4 text-2xl font-bold leading-tight md:text-3xl">
        <span class="lang-vi">{titleVi}</span>
        <span class="lang-en">{titleEn}</span>
        <span class="lang-km">{titleKm}</span>
      </h1>

      <p class="text-muted mt-3 text-sm leading-relaxed">
        <LangText text={tutorialChrome.guideLead} />
      </p>

      <a class="btn btn-secondary mt-5" href="/resources#cloudflare-resources">
        <LangText text={tutorialChrome.catalog} />
      </a>
    </header>

    {preview ? (
      <div class="space-y-8">
        <section class="card border-[var(--cf-accent)]/25 bg-gradient-to-br from-[rgba(255,140,56,0.06)] to-transparent p-6">
          <h2 class="text-lg font-semibold">
            <LangText text={tutorialChrome.quickContext} />
          </h2>
          <p class="lang-vi mt-3 text-sm leading-relaxed">{preview.explanationVi}</p>
          <p class="lang-en mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{preview.introEn}</p>
          <p class="lang-km mt-3 text-sm leading-relaxed text-[var(--text-muted)]">
            {preview.introKm ?? preview.introEn}
          </p>
        </section>

        <section class="tutorial-notes card p-6">
          <p class="tutorial-notes-kind">
            <span class="lang-vi">{tutorialChrome.notesKind.vi}</span>
            <span class="lang-en">{tutorialChrome.notesKind.en}</span>
            <span class="lang-km">{tutorialChrome.notesKind.km}</span>
          </p>
          <h2 class="mt-2 text-lg font-extrabold">
            <LangText text={tutorialChrome.notesBefore} />
          </h2>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm font-bold leading-relaxed">
            {preview.notesVi.map((note) => (
              <li class="lang-vi"><strong>{note}</strong></li>
            ))}
            {(preview.notesEn ?? []).map((note) => (
              <li class="lang-en"><strong>{note}</strong></li>
            ))}
            {(preview.notesKm ?? preview.notesEn ?? []).map((note) => (
              <li class="lang-km"><strong>{note}</strong></li>
            ))}
          </ul>
          {preview.lastReviewed ? (
            <p class="text-muted mt-4 text-xs font-semibold">
              <span class="lang-vi">{tutorialChrome.lastReviewed.vi} {preview.lastReviewed}</span>
              <span class="lang-en">{tutorialChrome.lastReviewed.en} {preview.lastReviewed}</span>
              <span class="lang-km">{tutorialChrome.lastReviewed.km} {preview.lastReviewed}</span>
            </p>
          ) : null}
        </section>

        {hasGuide ? (
          <TutorialGuide sections={preview.sections!} />
        ) : (
          <section class="card p-6">
            <p class="text-muted text-sm">
              <LangText text={tutorialChrome.notSynced} />
            </p>
          </section>
        )}

        <section class="card flex flex-col items-center gap-3 p-6 text-center sm:flex-row sm:justify-between sm:text-left">
          <p class="text-muted text-sm">
            <LangText text={tutorialChrome.viewFull} />
          </p>
          <a class="btn btn-primary shrink-0" href={officialUrl} target="_blank" rel="noopener noreferrer">
            <LangText text={tutorialChrome.officialDocs} />
          </a>
        </section>
      </div>
    ) : (
      <section class="card p-6">
        <p class="text-muted text-sm leading-relaxed">
          <LangText text={tutorialChrome.tutorialMissing} />
        </p>
        <a class="btn btn-primary mt-4" href={officialUrl} target="_blank" rel="noopener noreferrer">
          <LangText text={tutorialChrome.officialDocs} />
        </a>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .tutorial-notes {
    border: 1px solid color-mix(in srgb, var(--cf-accent) 45%, var(--cf-border));
    border-left-width: 5px;
    border-left-color: var(--cf-accent);
    background: color-mix(in srgb, var(--cf-accent) 12%, var(--cf-bg));
    box-shadow: 0 10px 24px -18px rgba(0, 0, 0, 0.45);
  }

  .tutorial-notes-kind {
    display: inline-flex;
    margin: 0;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    padding: 0.18rem 0.55rem;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
