---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/chrome/Breadcrumbs.astro';
import LangText from '../components/ui/LangText.astro';
import { enterpriseFacts, enterprisePageIntro, ENTERPRISE_OFFICIAL_URL } from '../data/enterprise';
---

<BaseLayout
  title={{
    vi: 'Gói Contract (Enterprise) trên Cloudflare',
    en: 'Cloudflare Contract (Enterprise) plan',
    km: 'Cloudflare Contract (Enterprise) plan',
  }}
  description={{
    vi: 'Giải thích ngắn gói Contract (Enterprise) và liên kết tới trang gói công khai của Cloudflare.',
    en: 'A short explanation of the Contract (Enterprise) plan, with a link to Cloudflare’s public plans page.',
    km: 'A short explanation of the Contract (Enterprise) plan, with a link to Cloudflare’s public plans page.',
  }}
  canonicalPath="/enterprise"
  showProgressBar
>
  <Breadcrumbs
    items={[
      { href: '/resources', label: { vi: 'Tài nguyên', en: 'Resources', km: 'Resources' } },
      { href: '/enterprise', label: { vi: 'Enterprise', en: 'Enterprise', km: 'Enterprise' } },
    ]}
  />

  <header class="mb-8">
    <LangText
      as="h1"
      class="text-2xl font-semibold md:text-3xl"
      text={{
        vi: 'Gói Contract (Enterprise)',
        en: 'Contract (Enterprise) plan',
        km: 'Contract (Enterprise) plan',
      }}
    />
    <LangText as="p" class="text-muted mt-2 max-w-3xl text-sm leading-relaxed md:text-base" text={enterprisePageIntro} />
    <p class="mt-4">
      <a class="btn btn-primary" href={ENTERPRISE_OFFICIAL_URL} target="_blank" rel="noopener noreferrer">
        <span class="lang-vi">Mở trang gói chính thức ↗</span>
        <span class="lang-en">Open the official plans page ↗</span>
        <span class="lang-km">Open the official plans page ↗</span>
      </a>
    </p>
  </header>

  <div class="grid gap-4 md:grid-cols-3">
    {
      enterpriseFacts.map((fact) => (
        <article class="card p-4">
          <LangText as="h2" class="text-base font-semibold" text={fact.title} />
          <LangText as="p" class="text-muted mt-2 text-sm leading-relaxed" text={fact.body} />
          <a class="link mt-3 inline-block text-xs" href={fact.source} target="_blank" rel="noopener noreferrer">
            <span class="lang-vi">Nguồn công khai ↗</span>
            <span class="lang-en">Public source ↗</span>
            <span class="lang-km">Public source ↗</span>
          </a>
        </article>
      ))
    }
  </div>

  <p class="mt-8 text-sm">
    <a class="link" href="/plans">
      <span class="lang-vi">← Cách đọc các gói trên hub</span>
      <span class="lang-en">← How this hub treats plans</span>
      <span class="lang-km">← How this hub treats plans</span>
    </a>
  </p>
</BaseLayout>
