---
import '../styles/global.css';
import Navbar from '../components/chrome/Navbar.astro';
import Footer from '../components/chrome/Footer.astro';
import ProgressBar from '../components/ui/ProgressBar';
import BackToTop from '../components/ui/BackToTop';
import { assetUrl } from '../lib/assets';
import { siteSeo, formatTitle } from '../lib/seo';

const faviconHref = assetUrl('favicon.svg');

type Props = {
  title: { vi: string; en: string };
  description: { vi: string; en: string };
  canonicalPath?: string;
  showProgressBar?: boolean;
  /** Override default OG image for this page */
  ogImage?: string;
  noindex?: boolean;
  /** Open Graph type — use `article` for blog posts */
  ogType?: 'website' | 'article';
};

const {
  title,
  description,
  canonicalPath,
  showProgressBar = false,
  ogImage,
  noindex = false,
  ogType = 'website',
} = Astro.props;
const enableWebMcp = canonicalPath === '/' || Astro.url.pathname === '/';
const siteName = siteSeo.name;
const siteOrigin = Astro.site ?? siteSeo.origin;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, siteOrigin);
const titleVi = formatTitle(title.vi, siteName);
const titleEn = formatTitle(title.en, siteName);
const imageUrl = new URL(ogImage ?? siteSeo.defaultImage, siteOrigin).href;
---

<html
  lang="vi"
  data-lang="vi"
  data-seo-title-vi={titleVi}
  data-seo-title-en={titleEn}
  data-seo-desc-vi={description.vi}
  data-seo-desc-en={description.en}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={siteSeo.themeColor} />

    <link rel="stylesheet" href="/styles/site.css" />
    <style is:inline>
      html[data-lang='en'] .lang-vi{display:none!important}
      html:not([data-lang='en']) .lang-en{display:none!important}
    </style>

    <style is:global>
      /* Shareable section-heading anchors (added by /scripts none; see BaseLayout script) */
      [data-anchor-heading]{ scroll-margin-top: 5.5rem; }
      .heading-anchor{
        position: relative;
        display: inline-flex;
        align-items: center;
        margin-right: 0.4rem;
        font-weight: 400;
        line-height: 1;
        color: var(--cf-accent);
        text-decoration: none;
        opacity: 0;
        transition: opacity 0.15s ease;
        vertical-align: middle;
        user-select: none;
      }
      :is(h1, h2, h3, h4) > .heading-anchor { font-size: 0.85em; }
      :is(h1, h2, h3, h4):hover > .heading-anchor,
      .heading-anchor:focus-visible { opacity: 0.75; }
      .heading-anchor:hover { opacity: 1; }
      .heading-anchor.is-copied { opacity: 1; }
      .heading-anchor.is-copied::after {
        content: 'Đã copy';
        position: absolute;
        top: 100%;
        left: 0;
        margin-top: 0.25rem;
        padding: 0.05rem 0.4rem;
        white-space: nowrap;
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--cf-accent);
        background: var(--cf-bg-elevated);
        border: 1px solid var(--cf-border);
        border-radius: 0.25rem;
        z-index: 20;
      }
      html[data-lang='en'] .heading-anchor.is-copied::after { content: 'Copied'; }
      @media (hover: none) { .heading-anchor { opacity: 0.5; } }
    </style>

    <title>{titleVi}</title>
    <meta name="description" content={description.vi} />

    <link rel="canonical" href={canonical.href} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={siteSeo.locale} />
    <meta property="og:locale:alternate" content={siteSeo.localeAlternate} />
    <meta property="og:title" content={titleVi} />
    <meta property="og:description" content={description.vi} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteSeo.twitterHandle} />
    <meta name="twitter:title" content={titleVi} />
    <meta name="twitter:description" content={description.vi} />
    <meta name="twitter:image" content={imageUrl} />

    <slot name="head" />

    <script is:inline define:vars={{ titleVi, titleEn, descriptionVi: description.vi, descriptionEn: description.en }}>
      (function () {
        var pageTitle = { vi: titleVi, en: titleEn };
        var pageDesc = { vi: descriptionVi, en: descriptionEn };
        try {
          var lang = localStorage.getItem('cfhub_language');
          if (lang !== 'en') lang = 'vi';
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang;
          document.title = pageTitle[lang] || pageTitle.vi;
          var meta = document.querySelector('meta[name="description"]');
          if (meta) meta.setAttribute('content', pageDesc[lang] || pageDesc.vi);
        } catch (e) {}
        try {
          var theme = localStorage.getItem('cfhub_theme');
          if (!theme) {
            theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          if (theme === 'dark') document.documentElement.classList.add('dark');
          else document.documentElement.classList.remove('dark');
        } catch (e) {}
      })();
    </script>
    {enableWebMcp ? <script is:inline src="/scripts/webmcp-bootstrap.js"></script> : null}
  </head>
  <body>
    <div class="min-h-dvh bg-hero">
      <Navbar />
      {showProgressBar ? <ProgressBar client:load /> : null}
      <main class="container py-10">
        <slot />
      </main>
      <BackToTop client:load />
      <Footer />
    </div>

    <script>
      // Give section headings stable, shareable, copyable anchor URLs
      // (e.g. /resources/#tai-lieu). Scoped to real section headings only —
      // card titles (inside <article>/.card) and interactive islands are skipped.
      (function () {
        function slugify(text) {
          return (text || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/[đĐ]/g, 'd')
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }

        function flash(anchor) {
          anchor.classList.add('is-copied');
          window.setTimeout(function () { anchor.classList.remove('is-copied'); }, 1400);
        }

        function init() {
          var main = document.querySelector('main');
          if (!main) return;

          var used = new Set();
          document.querySelectorAll('[id]').forEach(function (el) {
            if (el.id) used.add(el.id);
          });

          main.querySelectorAll('h2, h3').forEach(function (heading) {
            if (heading.hasAttribute('data-anchor-heading')) return;
            // Only anchor genuine section headings: nearest section/card/article/island must be a <section>.
            var boundary = heading.closest('section, article, astro-island, .card');
            if (!boundary || boundary.tagName !== 'SECTION') return;

            var viSpan = heading.querySelector('.lang-vi');
            var base = viSpan && viSpan.textContent.trim() ? viSpan.textContent : heading.textContent;
            var slug = slugify(base);
            if (!slug) return;

            var id = heading.id;
            if (!id) {
              var candidate = slug;
              var n = 2;
              while (used.has(candidate)) candidate = slug + '-' + n++;
              id = candidate;
              heading.id = id;
            }
            used.add(id);
            heading.setAttribute('data-anchor-heading', '');

            var anchor = document.createElement('a');
            anchor.className = 'heading-anchor';
            anchor.href = '#' + id;
            anchor.setAttribute('aria-label', 'Copy link to this section');
            anchor.innerHTML = '<span aria-hidden="true">#</span>';
            anchor.addEventListener('click', function (e) {
              e.preventDefault();
              var url = location.origin + location.pathname + '#' + id;
              try { history.replaceState(null, '', '#' + id); } catch (err) {}
              var target = document.getElementById(id);
              if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(function () { flash(anchor); }).catch(function () { flash(anchor); });
              } else {
                flash(anchor);
              }
            });
            heading.insertBefore(anchor, heading.firstChild);
          });

          // IDs are assigned at runtime, so resolve any incoming deep link manually.
          if (location.hash && location.hash.length > 1) {
            try {
              var target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
              if (target) requestAnimationFrame(function () { target.scrollIntoView({ block: 'start' }); });
            } catch (err) {}
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
